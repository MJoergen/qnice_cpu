[tasks]
cover
bmc
prove

[options]
cover: mode cover
cover: depth 10
cover: append 3
bmc: mode bmc
bmc: depth 10
prove: mode prove
prove: depth 10

[engines]
smtbmc

[script]
ghdl --std=08 fetch.vhd            fetch.psl \
              one_stage_buffer.vhd one_stage_buffer.psl \
              two_stage_buffer.vhd two_stage_buffer.psl \
              two_stage_fifo.vhd   two_stage_fifo.psl \
              pipe_concat.vhd      pipe_concat.psl \
              -e fetch
prep -top fetch

# Turn the sub-blocks' own input assumptions into assertions on fetch, so that
# this job also proves fetch drives them legally.
chformal -assume2assert fetch/* %M

# pipe_concat's f_s0_waits covers "s0 arrives before s1". Inside fetch, s1 is
# the address FIFO (filled when a request is ISSUED) and s0 is the data buffer
# (filled when the response ARRIVES), so against a slave that takes a cycle to
# answer the address is always present first and this ordering is unreachable
# by construction -- which is why it used to be removed here.
#
# It is reachable now. A zero-latency ACK pushes address and data on the SAME
# edge, and only the data buffer cuts through (two_stage_buffer); the address
# FIFO registers its output (two_stage_fifo), so the data leads by a cycle.
# The cover is therefore left in place, and it is the check that the
# zero-latency path really does drive the join in the new order.

[files]
fetch.psl
pipe_concat.psl
one_stage_buffer.psl
two_stage_buffer.psl
two_stage_fifo.psl
../src/fetch/fetch.vhd
../src/sub/pipe_concat.vhd
../src/sub/one_stage_buffer.vhd
../src/sub/two_stage_buffer.vhd
../src/sub/two_stage_fifo.vhd

