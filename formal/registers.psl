vunit i_registers(registers(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   ----------------------------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   ----------------------------------------------

   -- First clock cycle is reset
   f_reset : assume {rst_i};

   signal f_falling_rd_en   : std_logic;
   signal f_falling_src_reg : std_logic_vector(3 downto 0);
   signal f_falling_dst_reg : std_logic_vector(3 downto 0);

   p_falling : process (clk_i)
   begin
      if falling_edge(clk_i) then
         f_falling_rd_en   <= rd_en_i;
         f_falling_src_reg <= src_reg_i;
         f_falling_dst_reg <= dst_reg_i;
      end if;
   end process p_falling;

   -- Here we make sure that the input signals only transition on the rising
   -- clock edge, not on the falling clock edge.
   assume always {not clk_i} |-> {f_falling_rd_en = rd_en_i and f_falling_src_reg = src_reg_i and f_falling_dst_reg = dst_reg_i};


   ----------------------------------------------
   -- ASSERTIONS ON OUTPUTS
   ----------------------------------------------

   signal f_write_to_sr : std_logic;
   f_write_to_sr <= '1' when wr_en_i = '1' and wr_reg_i = C_REG_SR else '0';

   -- Verify correct sr behaviour: wr_en_i takes priority over wr_sr_en_i.
   -- Each property predicts sr_val_o one cycle out from a single triggering
   -- event; it only holds if no *other* SR write lands on that very next
   -- cycle and combinationally overrides the forwarded value.
   f_sr_a : assert always {wr_sr_en_i and not f_write_to_sr and not rst_i} |=> {wr_sr_en_i = '1' or f_write_to_sr = '1' or rst_i = '1' or sr_val_o = (prev(wr_sr_val_i) or X"0001")};
   f_sr_b : assert always {f_write_to_sr and not rst_i} |=> {wr_sr_en_i = '1' or f_write_to_sr = '1' or rst_i = '1' or sr_val_o = (prev(wr_val_i) or X"0001")};
   f_sr_c : assert always {rst_i} |=> {wr_sr_en_i = '1' or f_write_to_sr = '1' or sr_val_o = X"0001"};

   -- reg_sr itself always gives reset top priority over any concurrent write
   -- (see p_sr: the "if rst_i" branch is last, so it wins). The combinational
   -- sr_val_o mux must match that priority in the same cycle, not just once
   -- reg_sr has caught up on the next clock edge.
   f_sr_reset_priority : assert always {rst_i} |-> {sr_val_o = X"0001"};


   -- src_val_o/dst_val_o forward writes made through the dedicated SR port as
   -- well as the ordinary port, in the write cycle itself (wr_sr_en_i) and in
   -- the following cycle (wr_sr_en_d). Whenever this is asserted and the
   -- register being read back is R14, that forwarding combinationally
   -- overrides whatever older value a property below is predicting. That is
   -- the intended behaviour, not a defect, so every such property carries an
   -- escape clause built from this signal.
   signal f_sr_fwd : std_logic;
   f_sr_fwd <= '1' when wr_sr_en_i = '1' or wr_sr_en_d = '1' else '0';

   signal c_addr : std_logic_vector(3 downto 0);
   attribute anyconst : boolean;
   attribute anyconst of c_addr : signal is true;

   signal f_data    : std_logic_vector(15 downto 0);
   signal f_written : std_logic := '0';

   p_written : process (clk_i)
   begin
      if rising_edge(clk_i) then
         -- Store value written
         if wr_en_i = '1' and wr_reg_i = c_addr then
            f_data    <= wr_val_i;
            f_written <= '1';
         end if;

         -- Clear in case SR is updated.
         if (wr_en_i = '1' and wr_reg_i = 14) or wr_sr_en_i = '1' or rst_i = '1' then
            f_written <= '0';
         end if;
      end if;
   end process p_written;

   -- We can read back last value written to any given address, provided no
   -- other write to that same address lands on the checked cycle and
   -- combinationally forwards a newer value instead (see note above).
   f_read_back_src : assert always {f_written = '1' and src_reg_i = c_addr and wr_en_i = '0' and rd_en_i = '1'} |=> {(wr_en_i = '1' and wr_reg_i = c_addr) or (f_sr_fwd = '1' and c_addr = C_REG_SR) or src_val_o = f_data};
   f_read_back_dst : assert always {f_written = '1' and dst_reg_i = c_addr and wr_en_i = '0' and rd_en_i = '1'} |=> {(wr_en_i = '1' and wr_reg_i = c_addr) or (f_sr_fwd = '1' and c_addr = C_REG_SR) or dst_val_o = f_data};

   -- Write before read.
   -- The escape clause covers a *newer* write to the same register landing on
   -- the checked cycle and combinationally overriding the prediction. Since
   -- src_val_o/dst_val_o now also forward the dedicated SR port, such a newer
   -- write can arrive on either port when the register in question is R14.
   f_wbr_src : assert always {wr_en_i = '1' and rd_en_i = '1' and wr_reg_i = src_reg_i} |=> {(wr_en_i = '1' and wr_reg_i = prev(wr_reg_i)) or (f_sr_fwd = '1' and prev(wr_reg_i) = C_REG_SR) or src_val_o = prev(wr_val_i)};
   f_wbr_dst : assert always {wr_en_i = '1' and rd_en_i = '1' and wr_reg_i = dst_reg_i} |=> {(wr_en_i = '1' and wr_reg_i = prev(wr_reg_i)) or (f_sr_fwd = '1' and prev(wr_reg_i) = C_REG_SR) or dst_val_o = prev(wr_val_i)};

   -- Write before read
   f_wbr_stable_src : assert always {rd_en_i = '1'; wr_en_i = '1' and rd_en_i = '0' and wr_reg_i = prev(src_reg_i)} |=> {(wr_en_i = '1' and wr_reg_i = prev(wr_reg_i)) or (f_sr_fwd = '1' and prev(wr_reg_i) = C_REG_SR) or src_val_o = prev(wr_val_i)};
   f_wbr_stable_dst : assert always {rd_en_i = '1'; wr_en_i = '1' and rd_en_i = '0' and wr_reg_i = prev(dst_reg_i)} |=> {(wr_en_i = '1' and wr_reg_i = prev(wr_reg_i)) or (f_sr_fwd = '1' and prev(wr_reg_i) = C_REG_SR) or dst_val_o = prev(wr_val_i)};

   -- Write before read, through the DEDICATED SR port.
   -- Reading R14 as an ordinary register must see a value written via
   -- wr_sr_en_i/wr_sr_val_i, not the not-yet-updated reg_sr. Without the
   -- wr_sr_* forwarding terms in src_val_o/dst_val_o this fails.
   -- The rst_i guards are required. p_sr gives reset top priority over both
   -- write ports, so an SR write coinciding with reset leaves reg_sr at X"0001"
   -- rather than the written value; src_val_o/dst_val_o are don't-care there,
   -- since DECODE and PREPARE are flushed. Without these guards the properties
   -- hold only because the wr_sr_val_d term happens to return the written value
   -- during reset -- i.e. they would be testing an accident rather than the
   -- forwarding behaviour they are meant to pin down.
   f_wbr_sr_src : assert always {wr_sr_en_i = '1' and wr_en_i = '0' and rd_en_i = '1' and rst_i = '0' and src_reg_i = C_REG_SR} |=>
      {(wr_en_i = '1' and wr_reg_i = C_REG_SR) or wr_sr_en_i = '1' or rst_i = '1' or src_val_o = (prev(wr_sr_val_i) or X"0001")};
   f_wbr_sr_dst : assert always {wr_sr_en_i = '1' and wr_en_i = '0' and rd_en_i = '1' and rst_i = '0' and dst_reg_i = C_REG_SR} |=>
      {(wr_en_i = '1' and wr_reg_i = C_REG_SR) or wr_sr_en_i = '1' or rst_i = '1' or dst_val_o = (prev(wr_sr_val_i) or X"0001")};

   -- Output only changes when rd_en_i is high (or during write-before-read)
   f_stable_src : assert always {rd_en_i = '1'; wr_en_i = '0'[*]; wr_en_i = '0' and rd_en_i = '0'} |=> {wr_en_i = '1' or (f_sr_fwd = '1' and src_reg_d = C_REG_SR) or stable(src_val_o)};
   f_stable_dst : assert always {rd_en_i = '1'; wr_en_i = '0'[*]; wr_en_i = '0' and rd_en_i = '0'} |=> {wr_en_i = '1' or (f_sr_fwd = '1' and dst_reg_d = C_REG_SR) or stable(dst_val_o)};

   -- ...and a write to some OTHER register must not disturb it either. The two
   -- properties above only cover a quiet bus (wr_en_i = '0' throughout), so
   -- until these were added nothing said what a write to an unrelated register
   -- does to an output whose read address is standing still.
   --
   -- That is not a hypothetical hole. It surfaced while trying the timing
   -- experiment described above src_val_o in registers.vhd, which precomputes
   -- the delayed-forward condition a cycle early. Written the obvious way --
   -- comparing the write address against src_reg_i rather than against the
   -- value src_reg_d will actually hold -- it forwards a write aimed at a
   -- register nobody is reading, and every other property in this file passed
   -- on it. The experiment was reverted; these two stayed.
   --
   -- The reason the older properties miss it is worth knowing before trusting
   -- them elsewhere: whenever rd_en_i was low in the previous cycle, the
   -- delayed-forward term and the src_val_d term below it agree by
   -- construction, because the immediate forward already produced that value a
   -- cycle earlier and src_val_d carried it across. The two only disagree when
   -- the forward fires for the WRONG register, and no antecedent reached that.
   --
   -- The escape clauses are the usual ones: a write landing on the checked
   -- cycle legitimately overrides the prediction through the same
   -- combinational bypass, and so does an SR forward when the register being
   -- read is R14.
   f_undisturbed_src : assert always
      {rd_en_i = '1'; rd_en_i = '0' and wr_en_i = '1' and wr_reg_i /= src_reg_d and rst_i = '0'} |=>
      {wr_en_i = '1' or (f_sr_fwd = '1' and src_reg_d = C_REG_SR) or rst_i = '1' or stable(src_val_o)};
   f_undisturbed_dst : assert always
      {rd_en_i = '1'; rd_en_i = '0' and wr_en_i = '1' and wr_reg_i /= dst_reg_d and rst_i = '0'} |=>
      {wr_en_i = '1' or (f_sr_fwd = '1' and dst_reg_d = C_REG_SR) or rst_i = '1' or stable(dst_val_o)};


   ----------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   ----------------------------------------------


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------


   ----------------------------------------------
   -- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
   ----------------------------------------------

} -- vunit i_registers(registers(synthesis))

