## Verification matrix for dp_ram across both RAM styles and three modes.
##
## Task naming:  <mode>_<style>
##
##   prove_distributed - unbounded k-induction of the read-back contract.
##                       Fully closed by f_mem_shadow (distributed has a single
##                       rising-edge read register).
##
##   bmc_distributed   - bounded safety check of the same asserts (fast sanity /
##                       regression; also catches basecase-only issues).
##
##   bmc_block         - bounded safety check on the timing-accurate block RTL.
##                       Block adds a falling-edge read register (rd_data) with no
##                       RTL initializer and read-during-write collision, which
##                       makes a clean single-cycle inductive invariant awkward,
##                       so block is covered in bounded mode. Block and
##                       distributed are behaviourally identical at the rising-
##                       edge sample points (see the input-stability assumption in
##                       dp_ram.psl), so prove_distributed + bmc_block cover both.
##
##   cover_distributed /
##   cover_block       - reachability of the cover statements (f_toggle), i.e.
##                       that the harness can actually drive rd_en_i through its
##                       toggle sequence for each style.
##
## NOTE: prove_block is intentionally omitted - unbounded induction through the
## uninitialised, collision-prone falling-edge rd_data register is still open.
##
## Run one task:   sby -f dp_ram.sby bmc_block
## Run everything: sby -f dp_ram.sby

[tasks]
prove_distributed  prove  distributed
bmc_distributed    bmc    distributed
cover_distributed  cover  distributed
bmc_block          bmc    block
cover_block        cover  block
prove_block        prove  block

[options]
prove: mode prove
prove: depth 10
bmc:   mode bmc
bmc:   depth 20
cover: mode cover
cover: depth 20
multiclock on

[engines]
smtbmc

[script]
distributed: ghdl --std=08 -gG_ADDR_SIZE=4 -gG_DATA_SIZE=8 -gG_RAM_STYLE=distributed dp_ram.vhd dp_ram.psl -e dp_ram
block:       ghdl --std=08 -gG_ADDR_SIZE=4 -gG_DATA_SIZE=8 -gG_RAM_STYLE=block       dp_ram.vhd dp_ram.psl -e dp_ram
prep -top dp_ram

[files]
dp_ram.psl
../src/sub/dp_ram.vhd

