vunit i_dp_ram(dp_ram(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   ----------------------------------------------
   -- SHADOW OF THE TRACKED ADDRESS
   ----------------------------------------------

   -- Track one arbitrary-but-fixed address c_addr and shadow the last value
   -- written to it (f_data), together with a "seen a write" flag (f_written).
   signal c_addr : std_logic_vector(G_ADDR_SIZE-1 downto 0);
   attribute anyconst : boolean;
   attribute anyconst of c_addr : signal is true;

   signal f_data    : std_logic_vector(G_DATA_SIZE-1 downto 0);
   signal f_written : std_logic := '0';

   p_written : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if b_wr_en_i = '1' and b_addr_i = c_addr then
            f_data    <= b_wr_data_i;
            f_written <= '1';
         end if;
      end if;
   end process p_written;


   ----------------------------------------------
   -- ASSERTIONS ON OUTPUTS
   ----------------------------------------------

   -- We can read back the last value written to any given address.
   --
   -- Port A with its output register (G_READ_REG = true): NEXT rising edge,
   -- for both RAM styles.
   f_read_back : assert always
      {f_written = '1' and a_addr_i = c_addr and b_wr_en_i = '0' and a_rd_en_i = '1'}
      |=> {not G_READ_REG or a_rd_data_o = f_data};

   -- Port A without it (G_READ_REG = false), DISTRIBUTED style: same cycle.
   -- The read is asynchronous, so the data is on the output for the whole
   -- cycle in which the address is presented -- one rising-edge-to-rising-edge
   -- delay less than f_read_back. No a_rd_en_i escape is needed, unlike a
   -- next-cycle formulation: antecedent and consequent are the same cycle, so
   -- the read enable the antecedent requires is the one the output mask sees.
   f_read_back_async : assert always
      {f_written = '1' and a_addr_i = c_addr and b_wr_en_i = '0' and a_rd_en_i = '1'}
      |-> {G_READ_REG or G_RAM_STYLE /= "distributed" or a_rd_data_o = f_data};

   -- The same contract on read port B, which reads the array directly (it
   -- shares the write's process and clock edge, so it has no staging register).
   f_read_back_b : assert always
      {f_written = '1' and b_addr_i = c_addr and b_wr_en_i = '0' and b_rd_en_i = '1'}
      |=> {not G_READ_REG or b_rd_data_o = f_data};

   -- Port B with G_READ_REG = false. Simpler than port A: it has no staging
   -- register in either style, so dropping the output register leaves a plain
   -- asynchronous read and the same-cycle form holds for "block" and
   -- "distributed" alike -- no separate low-phase property needed.
   f_read_back_b_async : assert always
      {f_written = '1' and b_addr_i = c_addr and b_wr_en_i = '0' and b_rd_en_i = '1'}
      |-> {G_READ_REG or b_rd_data_o = f_data};

   -- Output value only changes when the port's read enable is asserted.
   -- Port A holds only while it has an output register to hold in; with
   -- G_READ_REG = false there is no register, and the contract is the mask
   -- below instead.
   f_stable_a : assert always {a_rd_en_i = '0'} |=> {not G_READ_REG or stable(a_rd_data_o)};
   f_stable_b : assert always {b_rd_en_i = '0'} |=> {not G_READ_REG or stable(b_rd_data_o)};

   -- The other half of that contract: an unregistered read port reads all-zeros
   -- while disabled, rather than leaking whatever the array holds at its
   -- address. These are the properties to delete if the mask is ever dropped
   -- for timing -- see G_READ_REG in dp_ram.vhd's header.
   f_read_zero_when_disabled : assert always
      {a_rd_en_i = '0'} |-> {G_READ_REG or a_rd_data_o = 0};
   f_read_zero_when_disabled_b : assert always
      {b_rd_en_i = '0'} |-> {G_READ_REG or b_rd_data_o = 0};


   ----------------------------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   ----------------------------------------------

   signal f_falling_a_rd_en   : std_logic;
   signal f_falling_a_rd_addr : std_logic_vector(G_ADDR_SIZE-1 downto 0);

   p_falling : process (clk_i)
   begin
      if falling_edge(clk_i) then
         f_falling_a_rd_en   <= a_rd_en_i;
         f_falling_a_rd_addr <= a_addr_i;
      end if;
   end process p_falling;

   -- Inputs may only transition on the rising edge, held stable across the whole
   -- cycle. This makes the block-RAM falling-edge read register a within-cycle
   -- timing relay rather than an extra unit of read latency, so that both
   -- G_RAM_STYLE configurations expose the same rising-edge-sampled behaviour.
   assume always {not clk_i}
      |-> {f_falling_a_rd_en = a_rd_en_i and f_falling_a_rd_addr = a_addr_i};


   -- Port A without it, BLOCK style: within the cycle, but only after the
   -- falling edge.
   --
   -- Neither rising-edge-sampled form works for this configuration, which is
   -- worth knowing before trying to simplify it. |=> is too late: the address
   -- has already moved on to the next cycle's value. |-> is too early: at the
   -- rising edge the falling-edge stage still holds the PREVIOUS cycle's
   -- capture, and BMC demonstrates it by simply parking the clock high so no
   -- falling edge ever arrives. The data genuinely appears mid-cycle, so the
   -- property has to be a low-phase one, which is the same reason f_rd_data
   -- below carries a clk_i = '0' guard.
   --
   -- Read through the falling-edge shadow rather than a_addr_i directly: those
   -- are equal by the stability assumption below, but going through the shadow
   -- is what makes the property say what it means -- the output reflects the
   -- address THIS capture used.
   f_read_back_async_block : assert always
      {clk_i = '0' and f_written = '1' and f_falling_a_rd_addr = c_addr
       and b_wr_en_i = '0' and f_falling_a_rd_en = '1'}
      |-> {G_READ_REG or G_RAM_STYLE /= "block" or a_rd_data_o = f_data};


   ----------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   ----------------------------------------------

   -- Useful for debugging, to make sure that a_rd_en_i is able to toggle.
   f_toggle : cover {a_rd_en_i = '1'; a_rd_en_i = '0'; a_rd_en_i = '1'};


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------

   -- The true memory array mirrors the shadow register. Without this,
   -- k-induction may start in an unreachable state where f_written='1' but
   -- dp_ram_r(c_addr) /= f_data, letting f_read_back fail spuriously (the
   -- "anyconst c_addr" CEX reported by SBY). This lemma is itself 1-inductive:
   -- a write to c_addr updates dp_ram_r(c_addr) and f_data identically, writes
   -- to other addresses touch neither, and f_written never de-asserts.
   --
   -- For G_RAM_STYLE = "distributed" this lemma is sufficient: *_rd_data_o is a
   -- direct rising-edge read of dp_ram_r, so f_read_back closes by k-induction.
   -- For G_RAM_STYLE = "block" each read path additionally contains a
   -- falling-edge register (*_rd_data), which needs its own mirror invariant --
   -- see f_rd_data below. Port B reads the array directly, so it needs none.
   f_mem_shadow : assert always
      {f_written = '1'} |-> {dp_ram_r(to_integer(c_addr)) = f_data};

   -- Block config only, port A only: throughout the low phase of the
   -- clock, the falling-edge staging register mirrors the memory word it captured
   -- (f_falling_rd_addr): the falling edge has just refreshed it, and no write
   -- can intervene before the next rising edge. Without this lemma, induction
   -- may start in an unreachable state where the staging register holds a value
   -- that never came out of the memory; the next rising edge then forwards that
   -- garbage into *_rd_data_o exactly when f_read_back samples it (the classic induction
   -- CEX for this design: clk_i parked low for the whole trace, one final
   -- rising edge, f_read_back fails).
   --
   -- The guard clk_i = '0' matters: during the high phase the mirror may
   -- legitimately be stale, namely when the rising edge that opened the phase
   -- wrote the very address the staging register had captured (a collision;
   -- the following falling edge resolves it). Restricting the lemma to the low
   -- phase makes it both true and inductive, and the low phase is exactly the
   -- state the read path consumes: every rising edge loads *_rd_data_o out of a
   -- low-phase state, so pinning the staging register there is sufficient.
   --
   -- For G_RAM_STYLE = "distributed" the consequent folds to a constant true
   -- (the staging registers are unused in that config). The style test lives in the consequent
   -- rather than the antecedent so that the antecedent stays reachable in both
   -- configs, keeping the auto-generated precondition cover satisfied.
   f_rd_data : assert always
      {clk_i = '0'}
      |-> {G_RAM_STYLE /= "block" or a_rd_data = dp_ram_r(to_integer(f_falling_a_rd_addr))};


} -- vunit i_dp_ram(dp_ram(synthesis))

