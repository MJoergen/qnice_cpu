vunit i_dp_ram(dp_ram(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   ----------------------------------------------
   -- SHADOW OF THE TRACKED ADDRESS
   ----------------------------------------------

   -- Track one arbitrary-but-fixed address c_addr and shadow the last value
   -- written to it (f_data), together with a "seen a write" flag (f_written).
   signal c_addr : std_logic_vector(G_ADDR_SIZE-1 downto 0);
   attribute anyconst : boolean;
   attribute anyconst of c_addr : signal is true;

   signal f_data    : std_logic_vector(G_DATA_SIZE-1 downto 0);
   signal f_written : std_logic := '0';

   p_written : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if wr_en_i = '1' and wr_addr_i = c_addr then
            f_data    <= wr_data_i;
            f_written <= '1';
         end if;
      end if;
   end process p_written;


   ----------------------------------------------
   -- ASSERTIONS ON OUTPUTS
   ----------------------------------------------

   -- We can read back the last value written to any given address.
   f_read_back : assert always
      {f_written = '1' and rd_addr_i = c_addr and wr_en_i = '0' and rd_en_i = '1'}
      |=> {rd_data_o = f_data};

   -- Output value only changes when rd_en_i is asserted.
   f_stable : assert always {not rd_en_i} |=> {stable(rd_data_o)};


   ----------------------------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   ----------------------------------------------

   signal f_falling_rd_en   : std_logic;
   signal f_falling_rd_addr : std_logic_vector(G_ADDR_SIZE-1 downto 0);

   p_falling : process (clk_i)
   begin
      if falling_edge(clk_i) then
         f_falling_rd_en   <= rd_en_i;
         f_falling_rd_addr <= rd_addr_i;
      end if;
   end process p_falling;

   -- Inputs may only transition on the rising edge, held stable across the whole
   -- cycle. This makes the block-RAM falling-edge read register a within-cycle
   -- timing relay rather than an extra unit of read latency, so that both
   -- G_RAM_STYLE configurations expose the same rising-edge-sampled behaviour.
   assume always {not clk_i}
      |-> {f_falling_rd_en = rd_en_i and f_falling_rd_addr = rd_addr_i};


   ----------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   ----------------------------------------------

   -- Useful for debugging, to make sure that rd_en_i is able to toggle.
   f_toggle : cover {rd_en_i = '1'; rd_en_i = '0'; rd_en_i = '1'};


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------

   -- The true memory array mirrors the shadow register. Without this,
   -- k-induction may start in an unreachable state where f_written='1' but
   -- dp_ram_r(c_addr) /= f_data, letting f_read_back fail spuriously (the
   -- "anyconst c_addr" CEX reported by SBY). This lemma is itself 1-inductive:
   -- a write to c_addr updates dp_ram_r(c_addr) and f_data identically, writes
   -- to other addresses touch neither, and f_written never de-asserts.
   --
   -- For G_RAM_STYLE = "distributed" this lemma is sufficient: rd_data_o is a
   -- direct rising-edge read of dp_ram_r, so f_read_back closes by k-induction.
   -- For G_RAM_STYLE = "block" the read path additionally contains the
   -- falling-edge register rd_data, which needs its own mirror invariant --
   -- see f_rd_data below.
   f_mem_shadow : assert always
      {f_written = '1'} |-> {dp_ram_r(to_integer(c_addr)) = f_data};

   -- Block config only: throughout the low phase of the clock, the falling-edge
   -- staging register mirrors the memory word at the address it captured
   -- (f_falling_rd_addr): the falling edge has just refreshed it, and no write
   -- can intervene before the next rising edge. Without this lemma, induction
   -- may start in an unreachable state where rd_data holds a value that never
   -- came out of the memory; the next rising edge then forwards that garbage
   -- into rd_data_o exactly when f_read_back samples it (the classic induction
   -- CEX for this design: clk_i parked low for the whole trace, one final
   -- rising edge, f_read_back fails).
   --
   -- The guard clk_i = '0' matters: during the high phase the mirror may
   -- legitimately be stale, namely when the rising edge that opened the phase
   -- wrote the very address rd_data had captured (read-during-write collision;
   -- the following falling edge resolves it). Restricting the lemma to the low
   -- phase makes it both true and inductive, and the low phase is exactly the
   -- state the read path consumes: every rising edge loads rd_data_o out of a
   -- low-phase state, so pinning rd_data there is sufficient for f_read_back.
   --
   -- For G_RAM_STYLE = "distributed" the consequent folds to a constant true
   -- (rd_data is unused in that config). The style test lives in the consequent
   -- rather than the antecedent so that the antecedent stays reachable in both
   -- configs, keeping the auto-generated precondition cover satisfied.
   f_rd_data : assert always
      {clk_i = '0'}
      |-> {G_RAM_STYLE /= "block" or rd_data = dp_ram_r(to_integer(f_falling_rd_addr))};

} -- vunit i_dp_ram(dp_ram(synthesis))

