vunit i_pipe_concat(pipe_concat(synthesis))
{
   -- set all declarations to run on clk_i
   default clock is rising_edge(clk_i);


   -----------------------------
   -- ASSERTIONS ABOUT OUTPUTS
   -----------------------------

   f_data_flowm: assert always {m_valid_o  and m_ready_i} |-> {s0_valid_i and s0_ready_o};
   f_data_flow0: assert always {s0_valid_i and s0_ready_o}|-> {s1_valid_i and s1_ready_o};
   f_data_flow1: assert always {s1_valid_i and s1_ready_o}|-> {m_valid_o  and m_ready_i};

   f_data: assert always {m_valid_o and m_ready_i} |-> {m_data_o = s1_data_i & s0_data_i};

   -- Output must be stable until accepted or reset.
   --
   -- "abort rst_i" is required, for the same reason it is required on
   -- one_stage_buffer/two_stage_buffer's own f_output_stable: pipe_concat is
   -- combinational, so m_valid_o is whatever its producers drive, and those
   -- producers gate their m_valid_o with "and not rst_i". Reset therefore
   -- clears m_valid_o within the SAME cycle it is sampled as the next state.
   -- That is intended reset behaviour, not a stability violation. It is
   -- unobservable when this file is checked standalone (the input assumptions
   -- below prevent it), but shows up as soon as pipe_concat is instantiated
   -- inside fetch, where rst_i is driven by "rst_i or dc_valid_i".
   f_output_stable : assert always {m_valid_o and not m_ready_i and not rst_i} |=> {stable(m_valid_o) and stable(m_data_o)} abort rst_i;


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Require reset at startup.
   f_reset : assume {rst_i};

   -- Input must be stable until accepted or reset.
   --
   -- The same "abort rst_i" escape as f_output_stable above, and it matters
   -- twice over: fetch.sby turns these assumptions into assertions on the
   -- enclosing design (chformal -assume2assert), and there the producers are
   -- real buffers whose m_valid_o really does drop combinationally on reset.
   f_input0_stable : assume always {s0_valid_i and not s0_ready_o and not rst_i} |=> {stable(s0_valid_i) and stable(s0_data_i)} abort rst_i;
   f_input1_stable : assume always {s1_valid_i and not s1_ready_o and not rst_i} |=> {stable(s1_valid_i) and stable(s1_data_i)} abort rst_i;


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- Make sure output can transition from full to empty.
   f_full_to_empty : cover {m_valid_o and not rst_i; not m_valid_o};

   -- Make sure output can stay valid for two clock cycles.
   f_back2back : cover {m_valid_o and m_ready_i; m_valid_o};

   -- s0 arrives first, then s1 completes the beat
   f_s0_waits : cover {s0_valid_i and not s1_valid_i and not rst_i; m_valid_o and m_ready_i};

   -- s1 arrives first, then s0 completes the beat
   f_s1_waits : cover {s1_valid_i and not s0_valid_i and not rst_i; m_valid_o and m_ready_i};

} -- vunit i_pipe_concat(pipe_concat(synthesis))

