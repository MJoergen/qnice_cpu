vunit i_cpu_main(cpu_main(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);

   -- NOTE: cpu_main.vhd deliberately imports only 't_stage' from cpu_constants,
   -- so the constants below are referenced by selected name rather than relying
   -- on a 'use work.cpu_constants.all' in the architecture.


   --------------------------------------------
   -- INTERNAL ASSERTIONS
   --------------------------------------------

   -- Payload stability on the DECODE -> PREPARE interface.
   --
   -- NOTE: this deliberately does NOT cover dec2prep_stage.src_val, .dst_val
   -- and .r14. Those three are combinational pass-throughs of the register file
   -- read ports (see the concurrent assignments in decode.vhd), not part of the
   -- latched payload, and they are *required* to move while DECODE is stalled:
   -- that is how a stalled instruction picks up a register or Status Register
   -- write issued by the older instruction still in WRITE, and how the second
   -- micro-op of e.g. ADD @R0++, @R0++ sees the R0 update made by the first.
   -- Asserting stable() over the whole record instead fails BMC at depth 4,
   -- with reg_r14_i changing on the cycle after reg_r14_we_o was asserted.
   -- The five alu_* fields are not driven by DECODE at all.
   f_dec2prep_valid_stable : assert always {dec2prep_valid and not dec2prep_ready and not rst_i and not fetch_valid_o} |=>
      {stable(dec2prep_valid) and
       stable(dec2prep_stage.microcodes) and
       stable(dec2prep_stage.addr) and
       stable(dec2prep_stage.inst) and
       stable(dec2prep_stage.immediate) and
       stable(dec2prep_stage.src_addr) and
       stable(dec2prep_stage.src_mode) and
       stable(dec2prep_stage.src_imm) and
       stable(dec2prep_stage.dst_addr) and
       stable(dec2prep_stage.dst_mode) and
       stable(dec2prep_stage.dst_imm) and
       stable(dec2prep_stage.res_reg) and
       stable(dec2prep_stage.is_crb)};

   -- The three live fields really are pure pass-throughs. These hold in every
   -- cycle, stalled or not, and would catch someone registering them by
   -- mistake -- which would silently reintroduce the stale-operand hazards
   -- described above.
   f_dec2prep_live_src : assert always {dec2prep_stage.src_val = reg_src_val_i};
   f_dec2prep_live_dst : assert always {dec2prep_stage.dst_val = reg_dst_val_i};
   f_dec2prep_live_r14 : assert always {dec2prep_stage.r14     = reg_r14_i};

--   f_dec2prep_ready_stable : assert always {dec2prep_ready and not dec2prep_valid and not rst_i} |=>
--      {stable(dec2prep_ready)};

   f_prep2wr_valid_stable : assert always {prep2wr_valid and not prep2wr_ready and not rst_i and not fetch_valid_o} |=>
      {stable(prep2wr_valid) and stable(prep2wr_stage)};

--   f_prep2wr_ready_stable : assert always {prep2wr_ready and not prep2wr_valid and not rst_i} |=>
--      {stable(prep2wr_ready)};


   ---------------------------------------
   -- PROPERTIES OF THE OUTPUT INTERFACE
   ---------------------------------------

   -- Don't accept single word, when we want two.
   f_fetch_double : assert always {fetch_double_o and not fetch_double_i} |-> {not fetch_ready_o};

   -- Memory request data must stay stable.
--   f_mem_req_stable : assert always {mem_req_valid_o and not mem_req_ready_i and not rst_i} |=>
--      {stable(mem_req_op_o) and stable(mem_req_addr_o) and stable(mem_req_data_o)};

   -- Memory response ready signal must stay stable.
   f_mem_src_ready_stable : assert always {mem_src_ready_o and not mem_src_valid_i and not rst_i and not fetch_valid_o} |=>
      {stable(mem_src_ready_o)};
   f_mem_dst_ready_stable : assert always {mem_dst_ready_o and not mem_dst_valid_i and not rst_i and not fetch_valid_o} |=>
      {stable(mem_dst_ready_o)};

   f_r14_bit0 : assert always {reg_r14_o(0) = '1'};

   signal c_src_reg : std_logic_vector(3 downto 0);
   signal c_src_val : std_logic_vector(15 downto 0);
   signal c_dst_reg : std_logic_vector(3 downto 0);
   attribute anyconst : boolean;
   attribute anyconst of c_src_reg : signal is true;
   attribute anyconst of c_src_val : signal is true;
   attribute anyconst of c_dst_reg : signal is true;

   signal f_move_reg_reg : std_logic;
   signal f_reg_read : std_logic;
   signal f_reg_write : std_logic;

   f_move_reg_reg <= '1' when fetch_data_i(15 downto 12) = work.cpu_constants.C_OPCODE_MOVE and
                              fetch_data_i(11 downto 8) = c_src_reg and
                              fetch_data_i(7 downto 6) = work.cpu_constants.C_MODE_REG and
                              fetch_data_i(5 downto 2) = c_dst_reg and
                              fetch_data_i(1 downto 0) = work.cpu_constants.C_MODE_REG else '0';

   f_reg_read <= '1' when reg_rd_en_o = '1' and reg_src_reg_o=c_src_reg and reg_dst_reg_o=c_dst_reg else '0';
   f_reg_write <= '1' when reg_we_o = '1' and reg_addr_o = c_dst_reg and reg_val_o = c_src_val else '0';

   -- Correctness of a MOVE <REG>,<REG> instruction, as two SAFETY properties.
   --
   -- This was once a single property of the shape
   --    {accepted} |-> {f_reg_read; true[*]; <completion>}
   -- which was vacuous past its first term: "true[*]" is an unbounded SERE
   -- repetition, so on a finite BMC trace the tail is always merely "pending"
   -- rather than violated. Inverting the written value, corrupting the written
   -- address, or suppressing the register write altogether were all NOT caught.
   --
   -- Bounding the repetition instead ("true[*0 to N]" -- note GHDL spells the
   -- range with "to", not ":") does not work either: the completion latency is
   -- genuinely unbounded here, because a preceding load stalls the pipeline
   -- until mem_src_valid_i arrives and nothing forces a response ever to
   -- arrive. The failure step just tracks N. Making it bounded would need
   -- fairness assumptions that BMC cannot discharge and that would remove the
   -- stall scenarios the other properties in this file rely on.
   --
   -- So the eventuality is dropped. What remains are two safety properties,
   -- one at each end of the instruction. Neither claims the instruction
   -- eventually completes -- that is liveness, and out of reach for BMC.

   -- (1) On accepting a MOVE <REG>,<REG>, the matching register read must be
   -- issued in that same cycle.
   f_mov_r_r_read : assert always {fetch_valid_i = '1' and fetch_ready_o = '1' and
                                   f_move_reg_reg = '1' and
                                   c_src_reg /= 15} |-> {f_reg_read = '1'};

   -- (2) Whenever a MOVE <REG>,<REG> completes in the WRITE stage, it must
   -- write the destination register with the value read for the source, update
   -- the flags, and issue no memory request.
   --
   -- The rst_i guard is required: during reset prep2wr_valid is unconstrained
   -- and the WRITE stage is forcing its reset-time write of R15, which matches
   -- the trigger by accident when c_src_reg = c_dst_reg = 0.
   signal f_mov_in_write : std_logic;
   f_mov_in_write <= '1' when prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_MOVE and
                              prep2wr_stage.inst(11 downto 8) = c_src_reg and
                              prep2wr_stage.inst(7 downto 6) = work.cpu_constants.C_MODE_REG and
                              prep2wr_stage.inst(5 downto 2) = c_dst_reg and
                              prep2wr_stage.inst(1 downto 0) = work.cpu_constants.C_MODE_REG else '0';

   f_mov_r_r_write : assert always {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and
                                    f_mov_in_write = '1' and
                                    c_src_reg /= 15} |->
                                   {mem_req_valid_o = '0' and
                                    reg_r14_we_o = '1' and
                                    f_reg_write = '1'};


   ------------------------------------------------------------------
   -- ADDC <REG>,<REG>: the Status Register path, in both directions
   ------------------------------------------------------------------
   --
   -- MOVE exercises the operand and write-back datapath but says nothing about
   -- R14, because MOVE neither reads a flag nor depends on one. ADDC is the
   -- smallest instruction that closes the loop in both directions:
   --
   --   R14 -> ALU : the carry-in comes from the Status Register, so a stale or
   --                mis-selected SR changes the RESULT, not just the flags.
   --   ALU -> R14 : all four of V, N, Z and C are written back, and the bits
   --                the instruction does not touch must be preserved.
   --
   -- Checking the sum is what makes the first direction observable: if the
   -- design took the wrong carry-in, reg_val_o is wrong by one.

   signal c_dst_val : std_logic_vector(15 downto 0);
   attribute anyconst of c_dst_val : signal is true;

   signal f_addc_reg_reg : std_logic;
   signal f_addc_in_write : std_logic;

   f_addc_reg_reg <= '1' when fetch_data_i(15 downto 12) = work.cpu_constants.C_OPCODE_ADDC and
                              fetch_data_i(11 downto 8) = c_src_reg and
                              fetch_data_i(7 downto 6) = work.cpu_constants.C_MODE_REG and
                              fetch_data_i(5 downto 2) = c_dst_reg and
                              fetch_data_i(1 downto 0) = work.cpu_constants.C_MODE_REG else '0';

   f_addc_in_write <= '1' when prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_ADDC and
                               prep2wr_stage.inst(11 downto 8) = c_src_reg and
                               prep2wr_stage.inst(7 downto 6) = work.cpu_constants.C_MODE_REG and
                               prep2wr_stage.inst(5 downto 2) = c_dst_reg and
                               prep2wr_stage.inst(1 downto 0) = work.cpu_constants.C_MODE_REG else '0';

   -- Reference model, written independently of the ALU: dst + src + C on 17
   -- bits, so bit 16 is the carry out. f_addc_sr_in is the Status Register this
   -- particular instruction captured; f_prep2wr_sr_fresh below is what ties
   -- that to the architectural SR.
   signal f_addc_sr_in  : std_logic_vector(15 downto 0);
   signal f_addc_sum    : std_logic_vector(16 downto 0);
   signal f_addc_zero   : std_logic;
   signal f_addc_ovf    : std_logic;
   signal f_addc_sr_out : std_logic_vector(15 downto 0);

   f_addc_sr_in <= prep2wr_stage.alu_flags;

   f_addc_sum <= ("0" & c_dst_val) + ("0" & c_src_val) + 1
                 when f_addc_sr_in(work.cpu_constants.C_SR_C) = '1' else
                 ("0" & c_dst_val) + ("0" & c_src_val);

   f_addc_zero <= '1' when f_addc_sum(15 downto 0) = X"0000" else '0';

   -- Same definition as alu_flags.vhd, restated rather than referenced: adding
   -- two operands of equal sign must not change the sign.
   f_addc_ovf <= (not c_src_val(15) and not c_dst_val(15) and     f_addc_sum(15)) or
                 (    c_src_val(15) and     c_dst_val(15) and not f_addc_sum(15));

   p_addc_sr_out : process (all)
   begin
      f_addc_sr_out <= f_addc_sr_in or X"0001";
      f_addc_sr_out(work.cpu_constants.C_SR_V) <= f_addc_ovf;
      f_addc_sr_out(work.cpu_constants.C_SR_N) <= f_addc_sum(15);
      f_addc_sr_out(work.cpu_constants.C_SR_Z) <= f_addc_zero;
      f_addc_sr_out(work.cpu_constants.C_SR_C) <= f_addc_sum(16);
   end process p_addc_sr_out;

   -- (1) On accepting an ADDC <REG>,<REG>, both operand reads must be issued
   -- in that same cycle -- same claim as f_mov_r_r_read.
   f_addc_r_r_read : assert always {fetch_valid_i = '1' and fetch_ready_o = '1' and
                                    f_addc_reg_reg = '1' and
                                    c_src_reg /= 15 and c_dst_reg /= 15} |-> {f_reg_read = '1'};

   -- (2) On completion in WRITE, the destination register gets dst + src + C
   -- and the Status Register gets exactly the flags that result implies, with
   -- every other SR bit carried over untouched.
   --
   -- c_dst_reg /= 14 because an instruction targeting R14 writes the Status
   -- Register through the ordinary register port as well, which is a different
   -- path and deserves its own property.
   f_addc_r_r_write : assert always {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and
                                     f_addc_in_write = '1' and
                                     c_src_reg /= 15 and c_dst_reg /= 15 and c_dst_reg /= 14} |->
                                    {mem_req_valid_o = '0' and
                                     reg_we_o = '1' and
                                     reg_addr_o = c_dst_reg and
                                     reg_val_o = f_addc_sum(15 downto 0) and
                                     reg_r14_we_o = '1' and
                                     reg_r14_o = f_addc_sr_out};

   -- (3) The Status Register an instruction carries into WRITE must be the one
   -- that was live at the register-file interface in the cycle PREPARE latched
   -- it -- this is the R14 -> ALU half of the pipelining claim, and it is what
   -- stops (2) from being a restatement of the implementation.
   --
   -- The antecedent is "PREPARE's output register was free to be updated",
   -- i.e. empty or being consumed; only then does a new beat appear. When it
   -- was stalled it keeps an older beat, and no claim is made.
   signal f_r14_prev : std_logic_vector(15 downto 0);

   p_r14_prev : process (clk_i)
   begin
      if rising_edge(clk_i) then
         f_r14_prev <= reg_r14_i;
      end if;
   end process p_r14_prev;

   f_prep2wr_sr_fresh : assert always {rst_i = '0' and
                                       (prep2wr_valid = '0' or prep2wr_ready = '1')} |=>
                                      {rst_i = '1' or prep2wr_valid = '0' or
                                       prep2wr_stage.alu_flags = f_r14_prev};


   ------------------------------------------------------------------
   -- MOVE with a memory operand: the addressing modes
   ------------------------------------------------------------------
   --
   -- The properties above only ever use C_MODE_REG, so nothing yet says how an
   -- address is formed, when the pointer register is updated, or that the value
   -- read from memory is the one written back.
   --
   -- The addressing mode is an anyconst rather than three copies of each
   -- property: @R, @R++ and @--R differ only in the address offset and the
   -- pointer write-back, so proving it for an arbitrary mode covers all three
   -- and keeps the expected-value arithmetic in one place.
   --
   -- R14 and R15 are excluded from both operands throughout. R15 as a pointer
   -- would bring in the Program Counter substitution in PREPARE (src_val_pc /
   -- dst_val_pc), and R14 as a destination is also written through the
   -- dedicated Status Register port. Both deserve properties of their own.

   signal c_src_mode : std_logic_vector(1 downto 0);
   signal c_dst_mode : std_logic_vector(1 downto 0);
   attribute anyconst of c_src_mode : signal is true;
   attribute anyconst of c_dst_mode : signal is true;

   signal c_mem_src_val : std_logic_vector(15 downto 0);
   signal c_mem_dst_val : std_logic_vector(15 downto 0);
   attribute anyconst of c_mem_src_val : signal is true;
   attribute anyconst of c_mem_dst_val : signal is true;

   -- An instruction whose operand registers and addressing modes are the
   -- anyconst ones, whatever the opcode. How an address is formed and when a
   -- pointer is written back is decided in WRITE from the mode and the
   -- microcode flags alone, with no reference to the opcode, so the addressing
   -- properties below are stated once for every instruction rather than per
   -- opcode. Only the properties about the DATA need to know which one it is.
   --
   -- The opcode is not ignored entirely: JMP and CTRL are excluded, because
   -- they re-purpose the operand fields. For a JMP, inst(5 downto 2) holds the
   -- jump mode, the negate flag and part of the condition -- not a destination
   -- register -- and DECODE synthesises a destination of its own: ASUB and RSUB
   -- push a return address, so their destination is @--R13 regardless of what
   -- the instruction word says. Generalising without this exclusion fails
   -- exactly there, with the design correctly writing the stack pointer while
   -- the property expects c_dst_reg. (The stack behaviour of ASUB/RSUB is not
   -- verified anywhere yet, and wants properties of its own.)
   signal f_operand_modes : std_logic;
   f_operand_modes <= '1' when prep2wr_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_JMP and
                               prep2wr_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_CTRL and
                               prep2wr_stage.inst(11 downto 8) = c_src_reg and
                               prep2wr_stage.inst(7 downto 6) = c_src_mode and
                               prep2wr_stage.inst(5 downto 2) = c_dst_reg and
                               prep2wr_stage.inst(1 downto 0) = c_dst_mode else '0';

   signal f_move_modes : std_logic;
   signal f_add_modes  : std_logic;
   f_move_modes <= f_operand_modes when prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_MOVE else '0';
   f_add_modes  <= f_operand_modes when prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_ADD  else '0';

   -- Operands that keep the general-purpose paths in play, and only those.
   signal f_gp_regs : std_logic;
   f_gp_regs <= '1' when c_src_reg /= 14 and c_src_reg /= 15 and
                         c_dst_reg /= 14 and c_dst_reg /= 15 else '0';

   -- Expected address and expected pointer write-back, per mode.
   signal f_src_mem_addr : std_logic_vector(15 downto 0);
   signal f_dst_mem_addr : std_logic_vector(15 downto 0);
   signal f_src_ptr_val  : std_logic_vector(15 downto 0);
   signal f_dst_ptr_val  : std_logic_vector(15 downto 0);

   f_src_mem_addr <= c_src_val - 1 when c_src_mode = work.cpu_constants.C_MODE_PRE else c_src_val;
   f_dst_mem_addr <= c_dst_val - 1 when c_dst_mode = work.cpu_constants.C_MODE_PRE else c_dst_val;
   f_src_ptr_val  <= c_src_val + 1 when c_src_mode = work.cpu_constants.C_MODE_POST else c_src_val - 1;
   f_dst_ptr_val  <= c_dst_val + 1 when c_dst_mode = work.cpu_constants.C_MODE_POST else c_dst_val - 1;

   -- What a MOVE to memory should store: the source register for MOVE <REG>,@R,
   -- and what memory returned for MOVE @R,@R. In both cases it is the value the
   -- instruction moves, never the pointer it moved it through.
   signal f_mov_dst_data : std_logic_vector(15 downto 0);
   f_mov_dst_data <= c_src_val when c_src_mode = work.cpu_constants.C_MODE_REG else c_mem_src_val;

   -- (1) SOURCE ADDRESS. The micro-op carrying MEM_READ_SRC must present a read
   -- request at the address the mode implies: the pointer register, or one below
   -- it for a pre-decrement. This is a property of the request as formed from
   -- the beat, so it does not wait for the request to be accepted.
   f_mem_src_addr : assert always {prep2wr_valid = '1' and rst_i = '0' and
                                   f_operand_modes = '1' and f_gp_regs = '1' and
                                   c_src_mode /= work.cpu_constants.C_MODE_REG and
                                   prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_SRC) = '1'} |->
                                  {mem_req_valid_o = '1' and
                                   mem_req_op_o(work.cpu_constants.C_MEM_READ_SRC) = '1' and
                                   mem_req_addr_o = f_src_mem_addr};

   -- (2) DESTINATION ADDRESS AND DATA. Whatever the source mode, the micro-op
   -- that completes a MOVE to memory must write the moved value at the address
   -- the destination mode implies.
   --
   -- This covers two shapes at once. MOVE <REG>,@<REG> is a single micro-op
   -- that writes memory. MOVE @<REG>,@<REG> is two: the first reads the source
   -- and bumps the source pointer, the second -- the one this triggers on --
   -- waits for that data and stores it. The only difference is where the data
   -- came from, which is what f_mov_dst_data captures.
   f_mov_dst_write : assert always {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and
                                    f_move_modes = '1' and f_gp_regs = '1' and
                                    c_dst_mode /= work.cpu_constants.C_MODE_REG} |->
                                   {mem_req_valid_o = '1' and
                                    mem_req_op_o(work.cpu_constants.C_MEM_WRITE) = '1' and
                                    mem_req_addr_o = f_dst_mem_addr and
                                    mem_req_data_o = f_mov_dst_data};

   -- The three memory op bits are mutually exclusive by construction of the
   -- microcode ROM -- one access per micro-op is the whole reason instructions
   -- are decomposed. Nothing downstream re-checks it, and the Memory module's
   -- own formal environment assumes it (f_mreq_op in memory.psl), so assert it
   -- here where it is actually produced.
   --
   -- The rst_i guard is the same one f_mov_r_r_write needs: during reset
   -- prep2wr_valid and the stage record are both unconstrained, so the op field
   -- is free to be any 3-bit value. Without it this fails at step 0.
   f_mem_op_onehot : assert always {mem_req_valid_o = '1' and rst_i = '0'} |->
                                   {mem_req_op_o = "001" or
                                    mem_req_op_o = "010" or
                                    mem_req_op_o = "100"};

   -- (3) POINTER WRITE-BACK. @R++ and @--R must leave the pointer register
   -- updated; plain @R must not touch it. Checked on the micro-op that carries
   -- the corresponding REG_MOD flag, which is the same one that issues the
   -- access.
   f_mem_src_ptr : assert always {prep2wr_valid = '1' and prep2wr_ready = '1' and rst_i = '0' and
                                  f_operand_modes = '1' and f_gp_regs = '1' and
                                  prep2wr_stage.microcodes(work.cpu_constants.C_REG_MOD_SRC) = '1' and
                                  (c_src_mode = work.cpu_constants.C_MODE_POST or
                                   c_src_mode = work.cpu_constants.C_MODE_PRE)} |->
                                 {reg_we_o = '1' and
                                  reg_addr_o = c_src_reg and
                                  reg_val_o = f_src_ptr_val};

   f_mem_dst_ptr : assert always {prep2wr_valid = '1' and prep2wr_ready = '1' and rst_i = '0' and
                                  f_operand_modes = '1' and f_gp_regs = '1' and
                                  prep2wr_stage.microcodes(work.cpu_constants.C_REG_MOD_DST) = '1' and
                                  prep2wr_stage.microcodes(work.cpu_constants.C_REG_WRITE) = '0' and
                                  (c_dst_mode = work.cpu_constants.C_MODE_POST or
                                   c_dst_mode = work.cpu_constants.C_MODE_PRE)} |->
                                 {reg_we_o = '1' and
                                  reg_addr_o = c_dst_reg and
                                  reg_val_o = f_dst_ptr_val};

   -- A plain @R is not an update: no register write may be issued for it.
   f_mem_no_ptr : assert always {prep2wr_valid = '1' and prep2wr_ready = '1' and rst_i = '0' and
                                     f_operand_modes = '1' and f_gp_regs = '1' and
                                     c_src_mode = work.cpu_constants.C_MODE_MEM and
                                     c_dst_mode = work.cpu_constants.C_MODE_MEM and
                                     prep2wr_stage.microcodes(work.cpu_constants.C_REG_WRITE) = '0'} |->
                                    {reg_we_o = '0'};

   -- (4) DESTINATION ADDRESS ON A READ. ADD-like instructions read the
   -- destination before writing it, which is a path nothing above exercises:
   -- MOVE never reads its destination, so C_MEM_READ_DST was untested. The
   -- address must be the one the destination mode implies -- and it must be the
   -- same address the result is later written to, which is what makes
   -- "read-modify-write" mean anything.
   f_mem_dst_addr : assert always {prep2wr_valid = '1' and rst_i = '0' and
                                   f_operand_modes = '1' and f_gp_regs = '1' and
                                   c_dst_mode /= work.cpu_constants.C_MODE_REG and
                                   prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_DST) = '1'} |->
                                  {mem_req_valid_o = '1' and
                                   mem_req_op_o(work.cpu_constants.C_MEM_READ_DST) = '1' and
                                   mem_req_addr_o = f_dst_mem_addr};

   -- (5) ADD <MEM>,<MEM>: the three-micro-op read-modify-write.
   --
   --   chunk 0: MEM_READ_SRC | REG_MOD_SRC   read the source, bump its pointer
   --   chunk 1: MEM_READ_DST                 read the destination
   --   chunk 2: LAST | REG_MOD_DST |         wait for both, add, store, bump
   --            MEM_WAIT_SRC | MEM_WAIT_DST |
   --            MEM_WRITE
   --
   -- This is the deepest instruction in the machine, and the only shape where
   -- two memory responses have to be held and combined. The claim is that both
   -- of them reach the ALU, that the sum goes back to the address the
   -- destination was read from, and that the flags describe that sum.
   signal f_add_sum    : std_logic_vector(16 downto 0);
   signal f_add_zero   : std_logic;
   signal f_add_ovf    : std_logic;
   signal f_add_sr_out : std_logic_vector(15 downto 0);

   f_add_sum  <= ("0" & c_mem_dst_val) + ("0" & c_mem_src_val);
   f_add_zero <= '1' when f_add_sum(15 downto 0) = X"0000" else '0';
   f_add_ovf  <= (not c_mem_src_val(15) and not c_mem_dst_val(15) and     f_add_sum(15)) or
                 (    c_mem_src_val(15) and     c_mem_dst_val(15) and not f_add_sum(15));

   p_add_sr_out : process (all)
   begin
      f_add_sr_out <= prep2wr_stage.alu_flags or X"0001";
      f_add_sr_out(work.cpu_constants.C_SR_V) <= f_add_ovf;
      f_add_sr_out(work.cpu_constants.C_SR_N) <= f_add_sum(15);
      f_add_sr_out(work.cpu_constants.C_SR_Z) <= f_add_zero;
      f_add_sr_out(work.cpu_constants.C_SR_C) <= f_add_sum(16);
   end process p_add_sr_out;

   f_add_mem_result : assert always {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and
                                     f_add_modes = '1' and f_gp_regs = '1' and
                                     c_src_mode /= work.cpu_constants.C_MODE_REG and
                                     c_dst_mode /= work.cpu_constants.C_MODE_REG} |->
                                    {mem_req_valid_o = '1' and
                                     mem_req_op_o(work.cpu_constants.C_MEM_WRITE) = '1' and
                                     mem_req_addr_o = f_dst_mem_addr and
                                     mem_req_data_o = f_add_sum(15 downto 0) and
                                     reg_r14_we_o = '1' and
                                     reg_r14_o = f_add_sr_out};

   -- (6) THE VALUE ACTUALLY MOVED. For MOVE @<REG>,<REG> the destination
   -- register must end up holding what memory returned, not the pointer.
   f_mov_mem_to_reg : assert always {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and
                                     f_move_modes = '1' and f_gp_regs = '1' and
                                     c_src_mode /= work.cpu_constants.C_MODE_REG and
                                     c_dst_mode = work.cpu_constants.C_MODE_REG} |->
                                    {reg_we_o = '1' and
                                     reg_addr_o = c_dst_reg and
                                     reg_val_o = c_mem_src_val};


   ------------------------------------------------------
   -- PIPELINE FLUSH: BANK SWITCH AND SELF-MODIFYING CODE
   ------------------------------------------------------

   -- fetch_valid_o is not just the redirect back to FETCH: cpu_main.vhd wires
   -- it into the reset pin of every flip-flop in DECODE and PREPARE, so it is
   -- also the pipeline flush. Three things raise it (see the expression at the
   -- end of write.vhd): a write to R15, a register bank switch, and a store
   -- that can land on an instruction already read. Only the first was covered
   -- by this file; the other two rested on simulation alone
   -- (test/prog_hazard.asm H11-H18, test/prog_self_modifying.asm).
   --
   -- Both are trigger conditions that invite "simplification" in the name of
   -- timing -- which has already cost the entire slack margin once, see the
   -- long comment above the bank switch in write.vhd. So what follows states
   -- the REQUIREMENT rather than restating the implementation: the RTL
   -- triggers are deliberately syntactic over-approximations, and these
   -- properties are what they have to cover. Over-approximating further stays
   -- legal; narrowing below these fails.

   signal f_r14_next : std_logic_vector(15 downto 0);

   -- The value actually landing in R14 this cycle. Mirrors the priority of the
   -- register file's own mux (and of the reg_r14_i assumption further down): a
   -- write through the ordinary register port to R14 beats the dedicated
   -- Status Register port.
   f_r14_next <= reg_val_o when reg_we_o = '1' and reg_addr_o = 14 else
                 reg_r14_o;

   -- Does an instruction CONSUME a value read out of the banked half of the
   -- register file, R0-R7? Only such a value can go stale when the bank moves
   -- underneath an already-issued read; a WRITE to R0-R7 travels down the
   -- pipeline as a register number and lands in whatever bank is current when
   -- it retires, which is the new one.
   --
   -- Both of these are written from the INSTRUCTION ENCODING -- the raw
   -- opcode, source register, destination register and destination mode
   -- fields -- and not from decode.vhd's uses_bank, nor from the src_addr /
   -- dst_addr fields DECODE derives from them. That is deliberate: uses_bank
   -- is the thing under test. Narrowing it (forgetting that ADD reads its
   -- destination, say, or that @R0 uses R0 as a pointer) has to fail here.
   --
   -- The source operand is consumed whenever there is one -- as an ALU input
   -- in register mode, as an address otherwise -- and only CTRL has none. The
   -- destination operand is consumed when the opcode reads it (everything
   -- except MOVE/SWAP/NOT/CTRL/JMP, whose flags come from the result alone)
   -- or when it is not in register mode, i.e. when the register holds a
   -- pointer. Bit 3 of a register number is the one that says "upper,
   -- unbanked": inst(11) for the source field, inst(5) for the destination.
   --
   -- JMP is excluded from the pointer term because DECODE replaces its
   -- destination with R13, which is unbanked anyway.

   signal f_prep_uses_bank  : std_logic;
   signal f_fetch_uses_bank : std_logic;

   f_prep_uses_bank <= '1' when
      (dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_CTRL and
       dec2prep_stage.inst(11) = '0') or
      (dec2prep_stage.inst(5) = '0' and
       ((dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_MOVE and
         dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_SWAP and
         dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_NOT and
         dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_CTRL and
         dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_JMP) or
        (dec2prep_stage.inst(15 downto 12) /= work.cpu_constants.C_OPCODE_JMP and
         dec2prep_stage.inst(1 downto 0) /= work.cpu_constants.C_MODE_REG)))
      else '0';

   f_fetch_uses_bank <= '1' when
      (fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_CTRL and
       fetch_data_i(11) = '0') or
      (fetch_data_i(5) = '0' and
       ((fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_MOVE and
         fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_SWAP and
         fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_NOT and
         fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_CTRL and
         fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_JMP) or
        (fetch_data_i(15 downto 12) /= work.cpu_constants.C_OPCODE_JMP and
         fetch_data_i(1 downto 0) /= work.cpu_constants.C_MODE_REG)))
      else '0';

   -- (1) THE REQUIREMENT. If the upper eight bits of R14 change, the register
   -- bank changes with them. DECODE issues its register read two stages ahead
   -- of WRITE, so the instruction sitting in DECODE's output register read its
   -- operands a cycle ago, against the OLD bank, and DECODE passes the
   -- register file's outputs through as live wires -- the values are gone. If
   -- that instruction consumes a banked value, only a flush can undo it.
   --
   -- The reference for "old bank" is prep2wr_stage.r14, i.e. the Status
   -- Register as it stood for the instruction now retiring -- not reg_r14_i,
   -- which the forwarding assumption below makes show the NEW value in the
   -- very same cycle, and which would therefore make this vacuous.
   --
   -- Note this compares banks, which the RTL never does; it triggers on
   -- "writes R14, or is INCRB/DECRB" instead. That is exactly what makes this
   -- a property and not a transcription.
   f_flush_on_bank_change : assert always
      {rst_i = '0' and prep2wr_valid = '1' and
       ((reg_we_o = '1' and reg_addr_o = 14) or reg_r14_we_o = '1') and
       f_r14_next(15 downto 8) /= prep2wr_stage.r14(15 downto 8) and
       dec2prep_valid = '1' and f_prep_uses_bank = '1'}
      |-> {fetch_valid_o = '1'};

   -- (2) THE SAME REQUIREMENT, one stage further back. The instruction at
   -- DECODE's INPUT is issuing its register read in this very cycle, and
   -- reg_sr does not take the new bank until this cycle's clock edge, so that
   -- read is against the old bank too. It has not been accepted yet, though,
   -- so there is a second way out: DECODE may simply refuse it and let it read
   -- again next cycle. Flush or hold -- what it must NOT do is take it.
   --
   -- Anything further back than this issues its read at least one cycle from
   -- now and needs nothing: hence exactly two properties, not a family of
   -- them.
   f_hold_on_bank_change : assert always
      {rst_i = '0' and prep2wr_valid = '1' and
       ((reg_we_o = '1' and reg_addr_o = 14) or reg_r14_we_o = '1') and
       f_r14_next(15 downto 8) /= prep2wr_stage.r14(15 downto 8) and
       fetch_valid_i = '1' and f_fetch_uses_bank = '1' and
       fetch_valid_o = '0'}
      |-> {fetch_ready_o = '0'};

   -- (3) THE MECHANISM for the one bank change that does not go through a
   -- register write at all. INCRB and DECRB reach R14 through the Status
   -- Register port, so the reg_addr_o term of fetch_valid_o never sees them;
   -- they need the separate is_crb term. Dropping it is the regression this
   -- catches, and it is the exact case test/prog_hazard.asm H11 covers.
   f_flush_on_crb : assert always
      {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
       prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
       (prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_INCRB or
        prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_DECRB) and
       dec2prep_valid = '1' and f_prep_uses_bank = '1'}
      |-> {fetch_valid_o = '1'};

   -- (5) THE EARLY REDIRECT. DECODE resolves an unconditional branch to an
   -- immediate target itself, two stages before WRITE would, and marks the
   -- instruction so that WRITE then does NOT redirect again -- see "Early
   -- redirect" in decode.vhd. The two properties below are the two halves of
   -- what makes that safe, and they are written from the raw instruction
   -- encoding rather than from early_jmp, so narrowing that signal fails them.
   --
   -- SOUNDNESS: the redirect only ever goes out for an instruction that really
   -- is such a branch, and only on the cycle DECODE accepts it. The
   -- fetch_ready_o term is the load-bearing one: the Icache's soft flush is
   -- driven from this signal and discards everything it holds, so a redirect
   -- raised on a cycle where the branch is NOT taken into DECODE would throw
   -- the branch itself away.
   f_early_sound : assert always
      {early_valid_o = '1'}
      |-> {fetch_valid_i = '1' and fetch_ready_o = '1' and
           fetch_double_i = '1' and
           fetch_data_i(15 downto 12) = work.cpu_constants.C_OPCODE_JMP and
           fetch_data_i(2 downto 0) = "000" and
           fetch_data_i(3) = '0' and
           fetch_data_i(11 downto 8) = work.cpu_constants.C_REG_PC and
           fetch_data_i(7 downto 6) = work.cpu_constants.C_MODE_POST};

   -- COMPLETENESS, and the more dangerous direction of the two. DECODE sets
   -- prep_stage_o.early_jmp from the same decode that raises early_valid_o, and
   -- WRITE suppresses its own redirect on that bit. So an accepted branch of
   -- this class that did NOT redirect here would never redirect at all: the
   -- CPU would fall through into whatever follows the branch. Nothing else in
   -- this file would notice.
   f_early_complete : assert always
      {rst_i = '0' and fetch_valid_i = '1' and fetch_ready_o = '1' and
       fetch_double_i = '1' and
       fetch_data_i(15 downto 12) = work.cpu_constants.C_OPCODE_JMP and
       fetch_data_i(2 downto 0) = "000" and
       fetch_data_i(3) = '0' and
       fetch_data_i(11 downto 8) = work.cpu_constants.C_REG_PC and
       fetch_data_i(7 downto 6) = work.cpu_constants.C_MODE_POST}
      |-> {early_valid_o = '1'};

   -- ...and it must be sent to the right place. Recomputed here from the
   -- instruction encoding, which is the same derivation WRITE would have
   -- applied two cycles later via prep_stage_o.immediate: the absolute modes
   -- branch to the operand, the relative ones to the operand plus the address
   -- of the word after it.
   f_early_addr_abs : assert always
      {early_valid_o = '1' and
       fetch_data_i(5 downto 4) /= work.cpu_constants.C_JMP_RBRA and
       fetch_data_i(5 downto 4) /= work.cpu_constants.C_JMP_RSUB}
      |-> {early_addr_o = fetch_data_i(31 downto 16)};

   f_early_addr_rel : assert always
      {early_valid_o = '1' and
       (fetch_data_i(5 downto 4) = work.cpu_constants.C_JMP_RBRA or
        fetch_data_i(5 downto 4) = work.cpu_constants.C_JMP_RSUB)}
      |-> {early_addr_o = fetch_data_i(31 downto 16) + fetch_addr_i + 2};

   -- (4) SELF-MODIFYING CODE. A store that can land on an instruction some
   -- stage has already read must flush. Everything already read lies in
   -- [next_pc, next_pc+8), and next_pc is addr+1 or addr+2, so in terms of the
   -- STORE ADDRESS the danger zone is addr+1 .. addr+10 -- hence the 11 below.
   -- See the derivation in write.vhd above smc_delta.
   --
   -- This deliberately measures mem_req_addr_o, the address the store really
   -- goes to, and not prep2wr_stage.dst_val, which is what smc_hit subtracts.
   -- The two differ by the pre-decrement mux, so this is a check on the
   -- implementation's window and not a copy of it: smc_hit's 32 has to be wide
   -- enough to absorb that offset, and if someone tightens it to the "exact"
   -- form the comment in write.vhd warns against, this is what notices.
   f_flush_on_smc : assert always
      {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
       mem_req_valid_o = '1' and
       mem_req_op_o(work.cpu_constants.C_MEM_WRITE) = '1' and
       mem_req_addr_o - prep2wr_stage.addr < 11}
      |-> {fetch_valid_o = '1'};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Always start in reset
   assume rst_i;
   assume not fetch_valid_i;
   assume always {true} |=> not rst_i;

   assume always {fetch_valid_i and not fetch_ready_o} |=> {stable(fetch_valid_i) and stable(fetch_addr_i) and stable(fetch_data_i(15 downto 0))};

   assume always {mem_src_valid_i and not mem_src_ready_o} |=> {stable(mem_src_valid_i) and stable(mem_src_data_i)};

   -- Model the memory as always returning c_mem_src_val on the source channel.
   -- Same abstraction, and same over-constraint, as the register reads above:
   -- it gives f_mov_mem_to_reg a concrete value to check against, at the price
   -- of excluding traces where two source reads return different data.
   assume always {mem_src_valid_i = '1'} |-> {mem_src_data_i = c_mem_src_val};
   assume always {mem_dst_valid_i = '1'} |-> {mem_dst_data_i = c_mem_dst_val};
   assume always {mem_dst_valid_i and not mem_dst_ready_o} |=> {stable(mem_dst_valid_i) and stable(mem_dst_data_i)};

   assume always {reg_rd_en_o = '1' and reg_src_reg_o=c_src_reg} |=> {reg_src_val_i = c_src_val};
   assume always {reg_rd_en_o = '0'} |=> {stable(reg_src_val_i) and stable(reg_dst_val_i)};

   -- NOTE: the assumption above models register c_src_reg as permanently
   -- holding c_src_val -- a read of it always returns the same value, even
   -- after the design writes to that register. That is what gives the MOVE
   -- properties something concrete to check against, but it is an
   -- over-constraint: traces in which a write changes c_src_reg are excluded
   -- from EVERY property in this file, not just those two.

   assume always {reg_rd_en_o = '1' and reg_dst_reg_o=c_dst_reg} |=> {reg_dst_val_i = c_dst_val};

   assume always {reg_r14_we_o = '0'} |=> {stable(reg_r14_i)};

   -- Model the register file's Status Register forwarding. registers.vhd drives
   -- sr_val_o combinationally from the SR write port (see the mux at the end of
   -- that file), so a write is visible on reg_r14_i in the SAME cycle -- which
   -- is exactly the forwarding that lets one instruction consume the flags the
   -- instruction ahead of it produced. Without this the SR input is left free
   -- after every write, and f_prep2wr_sr_fresh could not hold.
   --
   -- The guard mirrors that mux's priority: a write through the ORDINARY
   -- register port to R14 overrides the dedicated SR port.
   assume always {reg_r14_we_o = '1' and not (reg_we_o = '1' and reg_addr_o = 14)} |->
                 {reg_r14_i = (reg_r14_o or X"0001")};

   signal f_mem_src_request    : std_logic;
   signal f_mem_src_response   : std_logic;
   signal f_mem_dst_request    : std_logic;
   signal f_mem_dst_response   : std_logic;
   signal f_mem_src_oustanding : std_logic;
   signal f_mem_dst_oustanding : std_logic;

   f_mem_src_request  <= mem_req_valid_o and mem_req_ready_i and mem_req_op_o(work.cpu_constants.C_MEM_READ_SRC);
   f_mem_src_response <= mem_src_valid_i and mem_src_ready_o;
   f_mem_dst_request  <= mem_req_valid_o and mem_req_ready_i and mem_req_op_o(work.cpu_constants.C_MEM_READ_DST);
   f_mem_dst_response <= mem_dst_valid_i and mem_dst_ready_o;

   p_memory : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if f_mem_src_request and not f_mem_src_response then
            f_mem_src_oustanding <= '1';
         end if;
         if not f_mem_src_request and f_mem_src_response then
            f_mem_src_oustanding <= '0';
         end if;
         if f_mem_dst_request and not f_mem_dst_response then
            f_mem_dst_oustanding <= '1';
         end if;
         if not f_mem_dst_request and f_mem_dst_response then
            f_mem_dst_oustanding <= '0';
         end if;
         if rst_i = '1' then
            f_mem_src_oustanding <= '0';
            f_mem_dst_oustanding <= '0';
         end if;
      end if;
   end process p_memory;

   assume always {f_mem_src_oustanding} |-> {not f_mem_src_request};
   assume always {mem_src_valid_i}      |-> {f_mem_src_oustanding};
   assume always {f_mem_dst_oustanding} |-> {not f_mem_dst_request};
   assume always {mem_dst_valid_i}      |-> {f_mem_dst_oustanding};

   assume always {mem_req_ready_i and not mem_req_valid_o} |=> {stable(mem_req_ready_i)};



   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- Non-vacuity of the two MOVE properties. The trigger of each must be
   -- reachable, and the completion one must be reachable both for an ordinary
   -- destination and for c_dst_reg = R15, where the MOVE doubles as a jump.
   c_mov_read     : cover {fetch_valid_i = '1' and fetch_ready_o = '1' and f_move_reg_reg = '1' and c_src_reg /= 15};
   c_mov_write    : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_mov_in_write = '1' and c_src_reg /= 15};
   c_mov_write_pc : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_mov_in_write = '1' and c_src_reg /= 15 and c_dst_reg = 15};
   c_mov_write_gp : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_mov_in_write = '1' and c_src_reg /= 15 and c_dst_reg /= 15};

   -- Non-vacuity of the ADDC properties, and specifically of the two carry-in
   -- polarities: an ADDC completing with C=0 and with C=1 must both be
   -- reachable, or property (2) only ever checks one of the two sums.
   c_addc_read    : cover {fetch_valid_i = '1' and fetch_ready_o = '1' and f_addc_reg_reg = '1' and c_src_reg /= 15 and c_dst_reg /= 15};
   c_addc_write   : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_addc_in_write = '1' and c_src_reg /= 15 and c_dst_reg /= 15 and c_dst_reg /= 14};
   c_addc_carry_0 : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_addc_in_write = '1' and c_src_reg /= 15 and c_dst_reg /= 15 and c_dst_reg /= 14 and f_addc_sr_in(work.cpu_constants.C_SR_C) = '0'};
   c_addc_carry_1 : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_addc_in_write = '1' and c_src_reg /= 15 and c_dst_reg /= 15 and c_dst_reg /= 14 and f_addc_sr_in(work.cpu_constants.C_SR_C) = '1'};

   -- The scenario this whole section exists for: an ADDC completing in the very
   -- cycle after another instruction wrote the Status Register, i.e. the
   -- forwarded-flags case that test/prog_flags.asm exercises in simulation.
   c_addc_sr_forwarded : cover {reg_r14_we_o = '1'; prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_addc_in_write = '1' and c_src_reg /= 15 and c_dst_reg /= 15 and c_dst_reg /= 14};

   -- Non-vacuity of the addressing-mode properties. Each mode must be reachable
   -- on each side, otherwise the anyconst mode silently collapses to one case.
   c_mode_src_mem  : cover {prep2wr_valid = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_MEM  and prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_SRC) = '1'};
   c_mode_src_post : cover {prep2wr_valid = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_POST and prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_SRC) = '1'};
   c_mode_src_pre  : cover {prep2wr_valid = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_PRE  and prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_SRC) = '1'};
   c_mode_dst_mem  : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_REG and c_dst_mode = work.cpu_constants.C_MODE_MEM};
   c_mode_dst_post : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_REG and c_dst_mode = work.cpu_constants.C_MODE_POST};
   c_mode_dst_pre  : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_REG and c_dst_mode = work.cpu_constants.C_MODE_PRE};
   c_mode_mem_to_reg : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode /= work.cpu_constants.C_MODE_REG and c_dst_mode = work.cpu_constants.C_MODE_REG};

   -- Memory to memory: both operands behind a pointer, the two-micro-op shape.
   -- Covered for each destination mode, since the destination address and the
   -- pointer write-back are what differ between them.
   c_mem_to_mem      : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode /= work.cpu_constants.C_MODE_REG and c_dst_mode /= work.cpu_constants.C_MODE_REG};
   c_mem_to_mem_post : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_POST and c_dst_mode = work.cpu_constants.C_MODE_POST};
   c_mem_to_mem_pre  : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_move_modes = '1' and f_gp_regs = '1' and c_src_mode = work.cpu_constants.C_MODE_PRE  and c_dst_mode = work.cpu_constants.C_MODE_PRE};

   -- ADD <MEM>,<MEM>: each of the three micro-ops must be reachable, or the
   -- three-beat sequence is only ever checked in part.
   c_add_m_m_rd_src : cover {prep2wr_valid = '1' and rst_i = '0' and f_add_modes = '1' and f_gp_regs = '1' and c_src_mode /= work.cpu_constants.C_MODE_REG and c_dst_mode /= work.cpu_constants.C_MODE_REG and prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_SRC) = '1'};
   c_add_m_m_rd_dst : cover {prep2wr_valid = '1' and rst_i = '0' and f_add_modes = '1' and f_gp_regs = '1' and c_src_mode /= work.cpu_constants.C_MODE_REG and c_dst_mode /= work.cpu_constants.C_MODE_REG and prep2wr_stage.microcodes(work.cpu_constants.C_MEM_READ_DST) = '1'};
   c_add_m_m_write  : cover {prep2wr_valid = '1' and inst_done_o = '1' and rst_i = '0' and f_add_modes = '1' and f_gp_regs = '1' and c_src_mode /= work.cpu_constants.C_MODE_REG and c_dst_mode /= work.cpu_constants.C_MODE_REG};

   -- Non-vacuity: the stall condition that f_dec2prep_valid_stable predicates
   -- on must actually be reachable, otherwise that assertion proves nothing.
   -- The early redirect actually happening, for each of the two target
   -- computations. Without these, f_early_sound and the two address properties
   -- are all vacuously true if early_valid_o never fires at all -- which is
   -- exactly what a regression in decode.vhd's early_jmp would look like.
   c_early_redirect_abs : cover {early_valid_o = '1' and
                                 fetch_data_i(5 downto 4) = work.cpu_constants.C_JMP_ABRA};

   c_early_redirect_rel : cover {early_valid_o = '1' and
                                 fetch_data_i(5 downto 4) = work.cpu_constants.C_JMP_RSUB};

   c_dec2prep_stalled : cover {dec2prep_valid = '1' and dec2prep_ready = '0' and rst_i = '0' and fetch_valid_o = '0'};

   -- ... and the interesting case within it: a stall during which the Status
   -- Register is being rewritten, i.e. exactly the scenario that made the
   -- original whole-record stable() assertion fail.
   c_dec2prep_stalled_sr : cover {dec2prep_valid = '1' and dec2prep_ready = '0' and rst_i = '0' and fetch_valid_o = '0' and reg_r14_we_o = '1'};

   -- Non-vacuity of the three flush properties. Each antecedent has to be
   -- reachable, or the assertion above it proves nothing at all.
   c_flush_bank_change : cover {rst_i = '0' and prep2wr_valid = '1' and
                                ((reg_we_o = '1' and reg_addr_o = 14) or reg_r14_we_o = '1') and
                                f_r14_next(15 downto 8) /= prep2wr_stage.r14(15 downto 8)};
   c_flush_incrb       : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                                prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
                                prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_INCRB};
   c_flush_decrb       : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                                prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
                                prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_DECRB};

   -- The two flush properties qualify their conclusion on an in-flight
   -- instruction that actually consumes a banked value, so the qualified
   -- antecedent needs a cover of its own: without this the assertions could
   -- hold merely because f_prep_uses_bank / f_fetch_uses_bank are never true
   -- at the same time as a bank change.
   c_flush_bank_used   : cover {rst_i = '0' and prep2wr_valid = '1' and
                                ((reg_we_o = '1' and reg_addr_o = 14) or reg_r14_we_o = '1') and
                                f_r14_next(15 downto 8) /= prep2wr_stage.r14(15 downto 8) and
                                dec2prep_valid = '1' and f_prep_uses_bank = '1'};
   c_hold_bank_used    : cover {rst_i = '0' and prep2wr_valid = '1' and
                                ((reg_we_o = '1' and reg_addr_o = 14) or reg_r14_we_o = '1') and
                                f_r14_next(15 downto 8) /= prep2wr_stage.r14(15 downto 8) and
                                fetch_valid_i = '1' and f_fetch_uses_bank = '1'};

   -- The three outcomes of an INCRB/DECRB retiring, which is the whole point
   -- of bank_switch/bank_stale: a full flush, a one-cycle hold of DECODE's
   -- input, and -- the case worth having -- neither. If the last of these
   -- stops being reachable, the optimisation has been undone.
   c_crb_flush : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                        prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
                        (prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_INCRB or
                         prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_DECRB) and
                        fetch_valid_o = '1'};
   c_crb_hold  : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                        prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
                        (prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_INCRB or
                         prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_DECRB) and
                        fetch_valid_o = '0' and fetch_valid_i = '1' and fetch_double_o = '0' and
                        dec2prep_ready = '1' and fetch_ready_o = '0'};
   c_crb_free  : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                        prep2wr_stage.inst(15 downto 12) = work.cpu_constants.C_OPCODE_CTRL and
                        (prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_INCRB or
                         prep2wr_stage.inst(11 downto 6) = work.cpu_constants.C_CTRL_DECRB) and
                        fetch_valid_o = '0' and fetch_valid_i = '1' and dec2prep_valid = '1' and
                        fetch_ready_o = '1'};
   c_flush_smc         : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                                mem_req_valid_o = '1' and
                                mem_req_op_o(work.cpu_constants.C_MEM_WRITE) = '1' and
                                mem_req_addr_o - prep2wr_stage.addr < 11};

   -- The converse, and the reason the SMC trigger is a window rather than
   -- "every store": a store far away from the program counter must be able to
   -- retire WITHOUT flushing. Unconditional flushing is functionally correct,
   -- so no assertion in this file would notice it -- but it costs +64% of the
   -- run time of test/prog_interleave.asm. This cover is what notices.
   c_no_flush_far_store : cover {rst_i = '0' and prep2wr_valid = '1' and inst_done_o = '1' and
                                 mem_req_valid_o = '1' and
                                 mem_req_op_o(work.cpu_constants.C_MEM_WRITE) = '1' and
                                 fetch_valid_o = '0'};


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------


   ----------------------------------------------
   -- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
   ----------------------------------------------

--   assume always {mem_req_ready_i = '1'};

} -- vunit i_cpu_main(cpu_main(synthesis))


