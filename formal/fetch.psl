vunit i_fetch(fetch(synthesis))
{
   -----------------------------------------------------------------
   -- FREE CONSTANTS USED FOR THE END-TO-END DATA INTEGRITY PROOF
   -----------------------------------------------------------------
   -- The slave is assumed to always return f_const_data for f_const_addr.
   -- Since both are unconstrained constants, proving that DECODE receives
   -- f_const_data whenever it receives f_const_addr proves payload correctness
   -- for every address, without needing a scoreboard.
   --
   -- NOTE ON K-INDUCTION: f_dc_data_integrity is not expected to close under
   -- pure k-induction.  The induction hypothesis has to relate the CONTENTS of
   -- the address FIFO and the data buffer to f_const_addr / f_const_data, and
   -- neither block's internal storage is visible from this vunit.  Run it in
   -- bmc mode; to get it through prove mode, add matching invariants inside
   -- two_stage_fifo.psl and two_stage_buffer.psl, or comment out this
   -- declaration block together with f_const_addr_stable, f_const_data_stable,
   -- f_wb_slave_data, and f_dc_data_integrity -- nothing else depends on them.
   signal f_const_addr : std_logic_vector(15 downto 0);
   signal f_const_data : std_logic_vector(15 downto 0);

   attribute anyconst : boolean;
   attribute anyconst of f_const_addr : signal is true;
   attribute anyconst of f_const_data : signal is true;

   -----------------------------------------------------------------
   -- SHADOW STATE
   -----------------------------------------------------------------
   -- Everything below is recomputed from the module's PORTS only, so that the
   -- properties are independent of the internal implementation.  The shadow
   -- state is then cross-checked against the RTL state, which both catches
   -- bookkeeping bugs and provides strong invariants for k-induction.
   signal f_wb_outstanding     : integer range 0 to 3 := 0;

   -- Every acknowledgement the slave returns inside a live bus cycle,
   -- including one owed to a request that a redirect has abandoned. The design
   -- discards those itself rather than cancelling them by dropping CYC, so the
   -- shadow state has to see them; wb_rsp_accept, which the design gates, does
   -- not carry them.
   signal f_wb_ack : std_logic;
   signal f_wb_addr            : std_logic_vector(15 downto 0) := (others => '0');
   signal f_wb_stall_delay     : integer range 0 to 3 := 0;
   signal f_wb_ack_delay       : integer range 0 to 3 := 0;
   signal f_dc_stall_delay     : integer range 0 to 3 := 0;
   signal f_dc_last_addr_valid : std_logic := '0';
   signal f_dc_last_addr       : std_logic_vector(15 downto 0) := (others => '0');
   signal f_stb_pending        : integer range 0 to 1 := 0;

   -- Shadow queue holding the addresses of the outstanding requests, oldest
   -- first.  Used to relate an incoming ACK to the address that produced it.
   signal f_ack_addr0 : std_logic_vector(15 downto 0) := (others => '0');
   signal f_ack_addr1 : std_logic_vector(15 downto 0) := (others => '0');

   -- Address latched on abort, used to check the first instruction delivered
   -- to DECODE after a new PC.
   signal f_dc_new_pc_valid : std_logic := '0';
   signal f_dc_new_pc       : std_logic_vector(15 downto 0) := (others => '0');

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   --------------------------------------------
   -- SHADOW STATE MAINTENANCE
   --------------------------------------------

   f_wb_ack <= wb_cyc_o and wb_ack_i;

   -- Count the number of outstanding WISHBONE requests.
   -- Derived from ports only.  If CYC goes low the transaction is aborted and
   -- all outstanding requests are cancelled.
   --
   -- NOTE: the clearing condition is "CYC low", not "redirect". Those used to
   -- be the same thing, because a redirect always tore the bus cycle down.
   -- FETCH now keeps CYC asserted across a redirect where it can, and discards
   -- the acknowledgements owed to the abandoned requests itself, so a redirect
   -- on its own cancels nothing on the bus. Getting this wrong in the obvious
   -- direction -- clearing on dc_valid_i, as before -- makes
   -- f_wb_slave_ack_idle forbid exactly the stale acknowledgements that the
   -- discard logic exists to handle, and the whole mechanism goes unexercised
   -- while every property still passes.
   p_wb_outstanding : process (clk_i)
      variable n : integer range 0 to 3;
   begin
      if rising_edge(clk_i) then
         n := f_wb_outstanding;

         if wb_req_accept = '1' then
            n := n + 1;
         end if;

         if f_wb_ack = '1' then
            n := n - 1;
         end if;

         -- A redirect cancels everything outstanding exactly when FETCH cannot
         -- redirect the bus cycle and has to tear it down instead, which is
         -- when a request is stuck in a stall -- the only way STB can survive
         -- the acceptance step above. The condition is port-derived, and
         -- f_outstanding_match below cross-checks the result against the RTL's
         -- own counter, so a divergence between this mirror and fetch.vhd is
         -- caught rather than silently assumed away.
         --
         -- Clearing on "wb_cyc_o = '0'" instead looks equivalent and is not:
         -- the registered CYC goes low one cycle after the decision, which
         -- leaves a window where this counter is non-zero while CYC is already
         -- low, and f_inv_cyc_outstanding fails on it.
         if dc_valid_i = '1' and wb_stb_o = '1' and wb_stall_i = '1' then
            n := 0;
         end if;

         f_wb_outstanding <= n;

         if rst_i = '1' then
            f_wb_outstanding <= 0;
         end if;
      end if;
   end process p_wb_outstanding;

   -- Keep track of the address expected on the next WISHBONE request.
   p_wb_addr : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if wb_req_accept = '1' then
            f_wb_addr <= f_wb_addr + 1;
         end if;

         if dc_valid_i = '1' then
            f_wb_addr <= dc_addr_i;
         end if;

         if rst_i = '1' then
            f_wb_addr <= (others => '0');
         end if;
      end if;
   end process p_wb_addr;

   -- Shadow queue of outstanding request addresses.  Pop before push, so that
   -- a simultaneous ACK and request acceptance is handled correctly.
   p_ack_addr : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if f_wb_ack = '1' then
            f_ack_addr0 <= f_ack_addr1;
         end if;

         if wb_req_accept = '1' then
            if f_wb_outstanding = 0 or
               (f_wb_outstanding = 1 and f_wb_ack = '1') then
               f_ack_addr0 <= wb_addr_o;
            else
               f_ack_addr1 <= wb_addr_o;
            end if;
         end if;
      end if;
   end process p_ack_addr;

   -- Number of requests asserted on STB but not yet accepted (0 or 1).
   p_stb_pending : process (wb_stb_o)
   begin
      if wb_stb_o = '1' then
         f_stb_pending <= 1;
      else
         f_stb_pending <= 0;
      end if;
   end process p_stb_pending;

   -- Record the last address delivered to DECODE.
   p_dc_last_addr : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if dc_accept = '1' then
            f_dc_last_addr_valid <= '1';
            f_dc_last_addr       <= dc_addr_o;
         end if;

         if rst_i = '1' or dc_valid_i = '1' then
            f_dc_last_addr_valid <= '0';
         end if;
      end if;
   end process p_dc_last_addr;

   -- Record the new PC supplied by WRITE, until the first instruction fetched
   -- from it has been delivered.
   p_dc_new_pc : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if dc_accept = '1' then
            f_dc_new_pc_valid <= '0';
         end if;

         if dc_valid_i = '1' then
            f_dc_new_pc_valid <= '1';
            f_dc_new_pc       <= dc_addr_i;
         end if;

         if rst_i = '1' then
            f_dc_new_pc_valid <= '0';
         end if;
      end if;
   end process p_dc_new_pc;


   --------------------------------------------
   -- INTERNAL ASSERTIONS
   --------------------------------------------

   -- The address fifo should always accept an incoming address.
   -- This prevents data loss and/or corruption.
   --
   -- Qualified by the abort and reset, because the FIFO's rst_i is driven by
   -- "rst_i or dc_valid_i" and its s_ready_o is now gated by that signal. A
   -- request already asserted on STB may be accepted by the slave in the very
   -- cycle WRITE issues a redirect, so wb_req_accept and a low
   -- tsf_in_addr_ready coincide. That is not data loss: the address belongs
   -- to the stream being abandoned, and the FIFO is flushed on the same edge.
   -- Before s_ready_o was gated, the FIFO accepted the address and discarded
   -- it one edge later via its own reset
   -- same outcome, different handshake.
   f_addr_ready : assert always
      {wb_req_accept = '1' and dc_valid_i = '0' and rst_i = '0'} |-> {tsf_in_addr_ready = '1'};

   -- The data buffer must always accept an incoming response.
   -- This prevents data loss and/or corruption.
   --
   -- Same escape clause, and same reasoning, as f_addr_ready above:
   -- i_two_stage_buffer_data is reset with "rst_i or dc_valid_i", and
   -- one_stage_buffer gates s_ready_o with "and not rst_i". So a response the
   -- slave acks in the very cycle WRITE issues a redirect (or in reset) meets
   -- a low tsb_in_data_ready. That is not data loss: the response belongs to
   -- the instruction stream being abandoned, and the buffer is flushed on the
   -- same edge. Without the escape, BMC finds this immediately.
   f_data_ready : assert always
      {wb_rsp_accept = '1' and dc_valid_i = '0' and rst_i = '0'} |-> {tsb_in_data_ready = '1'};

   -- The RTL bookkeeping must agree with the port-derived shadow state.
   f_outstanding_match : assert always
      {not rst_i} |-> {wb_outstanding = f_wb_outstanding};


   ------------------------------------------------
   -- PROPERTIES OF THE WISHBONE MASTER INTERFACE
   ------------------------------------------------

   -- WISHBONE MASTER: Clear all requests after a reset.
   f_wb_master_reset : assert always
      {rst_i} |=> {not wb_cyc_o and not wb_stb_o};

   -- WISHBONE MASTER: STB must be low when CYC is low.
   f_wb_master_stb_low : assert always
      {not wb_cyc_o} |-> {not wb_stb_o};

   -- WISHBONE MASTER: CYC must be held until every accepted request has been
   -- acknowledged.  Dropping CYC early cancels responses that the design is
   -- still waiting for.  This is the property that the previous fill-based
   -- termination logic satisfied only by accident.
   --
   -- The escape term is essential and easy to get wrong: the antecedent
   -- samples f_wb_outstanding BEFORE the acknowledgement that arrives during
   -- the same cycle.  When that acknowledgement retires the last outstanding
   -- request, the count is zero by the end of the cycle and terminating the
   -- bus cycle is not merely allowed but required.  Since f_wb_outstanding is
   -- evaluated in the consequent at the NEXT cycle, it already reflects that
   -- decrement, so "or f_wb_outstanding = 0" excuses exactly the drain case
   -- and nothing else.
   f_wb_master_cyc_hold : assert always
      {f_wb_outstanding > 0 and dc_valid_i = '0' and rst_i = '0'} |=>
      {wb_cyc_o = '1' or f_wb_outstanding = 0};

   -- WISHBONE MASTER: While a request is stalled it must not change, except on
   -- reset or abort.
   f_wb_master_stable : assert always
      {wb_stb_o and wb_stall_i and not dc_valid_i and not rst_i} |=>
      {stable(wb_stb_o) and stable(wb_addr_o)};

   -- WISHBONE MASTER: At most two outstanding requests.
   f_wb_master_req_count_max : assert always
      {f_wb_outstanding >= 2} |-> {not wb_stb_o};

   -- WISHBONE MASTER: Verify the address requested is as expected.
   f_wb_master_address : assert always
      {wb_stb_o} |-> {wb_addr_o = f_wb_addr};


   ---------------------------------------
   -- PROPERTIES OF THE DECODE INTERFACE
   --
   -- NOTE: "dc_" covers both directions. dc_valid_o/dc_addr_o/dc_data_o carry
   -- instructions towards DECODE (via ICACHE); dc_valid_i/dc_addr_i are the PC
   -- redirect, which comes from WRITE, not from DECODE.
   ---------------------------------------

   -- DECODE ASSERT: The output must be stable while not accepted, unless the
   -- transaction is aborted.
   -- The "abort" is required on the consequent side as well as the trigger
   -- side: dc_valid_o comes straight out of i_pipe_concat, whose producers gate
   -- their m_valid_o with "and not rst_i", and whose reset here is
   -- "rst_i or dc_valid_i". A redirect asserted by WRITE in the consequent
   -- cycle therefore drops dc_valid_o in that same cycle -- which is exactly
   -- what WRITE just asked for, not a stability violation.
   f_dc_assert_stable : assert always
      {dc_valid_o and not dc_ready_i and not rst_i and not dc_valid_i} |=>
      {stable(dc_valid_o) and stable(dc_addr_o) and stable(dc_data_o)}
      abort (rst_i or dc_valid_i);

   -- DECODE ASSERT: Addresses forwarded to DECODE increment by one.  Note that
   -- f_dc_last_addr_valid is already cleared on reset and abort, so the
   -- antecedent does not need to observe the preceding handshake; this checks
   -- the increment across stall cycles as well.
   f_dc_assert_addr : assert always
      {f_dc_last_addr_valid and dc_valid_o} |-> {dc_addr_o = f_dc_last_addr + 1};

   -- DECODE ASSERT: A new PC flushes the pipeline; no stale instruction may be
   -- presented in the following cycle.
   f_dc_flush_on_abort : assert always
      {dc_valid_i} |=> {not dc_valid_o};

   -- DECODE ASSERT: The first instruction delivered after a new PC must be the
   -- instruction at that PC.
   f_dc_new_pc_addr : assert always
      {f_dc_new_pc_valid and dc_valid_o} |-> {dc_addr_o = f_dc_new_pc};

   -- DECODE ASSERT: End-to-end data integrity.  The instruction word delivered
   -- for a given address must be the word the slave returned for that address.
   f_dc_data_integrity : assert always
      {dc_valid_o = '1' and dc_addr_o = f_const_addr} |-> {dc_data_o = f_const_data};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Count the number of consecutive clock cycles the WISHBONE slave stalls.
   p_wb_stall_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if wb_stb_o = '1' and wb_stall_i = '1' then
            f_wb_stall_delay <= f_wb_stall_delay + 1;
         else
            f_wb_stall_delay <= 0;
         end if;
      end if;
   end process p_wb_stall_delay;

   -- Count the number of consecutive clock cycles the WISHBONE slave owes a
   -- response without providing one.
   p_wb_ack_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if f_wb_outstanding > 0 and wb_ack_i = '0' then
            f_wb_ack_delay <= f_wb_ack_delay + 1;
         else
            f_wb_ack_delay <= 0;
         end if;
      end if;
   end process p_wb_ack_delay;

   -- Count the number of consecutive cycles DECODE applies backpressure.
   p_dc_stall_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if dc_valid_o = '1' and dc_ready_i = '0' then
            f_dc_stall_delay <= f_dc_stall_delay + 1;
         else
            f_dc_stall_delay <= 0;
         end if;
      end if;
   end process p_dc_stall_delay;

   -- Require reset at startup.
   f_reset : assume {rst_i};

   -- WISHBONE SLAVE: No ACKs without an outstanding request.  This also
   -- encodes the requirement that a slave must not acknowledge a request that
   -- was cancelled by deasserting CYC.
   f_wb_slave_ack_idle : assume always
      {f_wb_outstanding = 0} |-> {not wb_ack_i};

   -- WISHBONE SLAVE: The data returned for f_const_addr is always
   -- f_const_data.  f_ack_addr0 is the address of the oldest outstanding
   -- request, i.e. the one being acknowledged.
   f_wb_slave_data : assume always
      {f_wb_ack = '1' and f_ack_addr0 = f_const_addr} |-> {wb_data_i = f_const_data};

   -- WISHBONE SLAVE: Stall for at most three consecutive cycles.  This is an
   -- artificial constraint.  It is written as an implication on the input so
   -- that it constrains the environment only and can never rule out a design
   -- state, which would make the whole proof vacuous.
   f_wb_slave_stall_delay_max : assume always
      {f_wb_stall_delay = 2} |=> {not wb_stall_i or not wb_stb_o};

   -- WISHBONE SLAVE: Respond within at most three cycles.  Artificial
   -- constraint; the escape term covers the case where the request was
   -- cancelled by an abort in the meantime.
   f_wb_slave_ack_delay_max : assume always
      {f_wb_ack_delay = 2} |=> {wb_ack_i = '1' or f_wb_outstanding = 0};

   -- WRITE ASSUME: Send a new PC right after reset.
   f_dc_after_reset : assume always
      {rst_i} |=> {dc_valid_i};

   -- DECODE ASSUME: Artificially constrain the maximum DECODE backpressure.
   f_dc_assume_stall_delay_max : assume always
      {f_dc_stall_delay = 2} |=> {dc_ready_i or not dc_valid_o};


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- DECODE accepts data
   f_dc_accept : cover {dc_valid_o; not dc_valid_o};

   -- DECODE receives two data cycles back-to-back
   f_dc_back2back : cover {dc_valid_o and dc_ready_i; dc_valid_o};

   -- DECODE receives three data cycles back-to-back
   f_dc_back3back : cover {dc_valid_o and dc_ready_i; dc_valid_o and dc_ready_i; dc_valid_o};

   -- An abort while a transaction is in progress
   f_cover_abort_active : cover {wb_cyc_o and dc_valid_i};

   -- An abort while two requests are outstanding.  This is now also the case
   -- that forces the bus cycle to be torn down rather than redirected, since
   -- redirecting it would need a third request slot.
   f_cover_abort_full : cover {f_wb_outstanding = 2 and dc_valid_i = '1'};

   -- A redirect that keeps the bus cycle alive, leaving an acknowledgement
   -- owed to a request nobody wants any more.  This is the scenario the whole
   -- fast path turns on: without this cover the discard logic could be dead
   -- code and every assertion above would still pass.
   f_cover_abort_redirect : cover {f_wb_outstanding = 1 and dc_valid_i = '1' and wb_stb_o = '0'};

   -- ...and the acknowledgement actually arriving afterwards, which is the
   -- moment the discard either works or corrupts the instruction stream.
   f_cover_stale_ack : cover {f_wb_outstanding = 1 and dc_valid_i = '1' and wb_stb_o = '0'; wb_ack_i = '1'};

   -- Both outstanding request slots in use
   f_cover_two_outstanding : cover {f_wb_outstanding = 2};

   -- A stalled request
   f_cover_stall : cover {wb_stb_o and wb_stall_i};

   -- The address FIFO completely full
   f_cover_addr_fifo_full : cover {tsf_in_addr_fill = 2};

   -- The bus cycle terminating and later restarting
   f_cover_cyc_restart : cover {wb_cyc_o; not wb_cyc_o; wb_cyc_o};

   -- VACUITY CHECK for f_dc_data_integrity.
   --
   -- f_dc_data_integrity only says something if its antecedent is reachable,
   -- i.e. if an instruction is ever delivered to DECODE at the address held in
   -- the free constant f_const_addr.  If the trace is never long enough for
   -- that to happen, the assertion passes without checking anything.  These
   -- covers make that failure mode visible.
   --
   -- Be aware of what the solver is allowed to do here: f_const_addr is an
   -- unconstrained constant, so in COVER mode the solver chooses it to make
   -- the cover succeed.  It will simply set f_const_addr to whatever address
   -- happens to be delivered first.  That is still a useful check -- it proves
   -- the antecedent shape is satisfiable and that the constant participates in
   -- a real delivery -- but it does NOT prove that an arbitrary address is
   -- reachable.  In ASSERT mode the quantification runs the other way (the
   -- proof must hold for every value), which is what gives the integrity
   -- property its strength.
   f_cover_const_fetched : cover {dc_valid_o = '1' and dc_addr_o = f_const_addr};

   -- Stronger variant: the constant address is delivered AND is not the PC
   -- that DECODE supplied, so at least one address increment and a full
   -- request/response round trip must have occurred to reach it.  This closes
   -- the loophole where the solver satisfies the cover above by pointing
   -- f_const_addr at the very first instruction after a branch.
   f_cover_const_fetched_deep : cover
      {dc_valid_o = '1' and dc_addr_o = f_const_addr and f_dc_last_addr_valid = '1'};


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------

   -- The number of allocated slots equals the request waiting on STB plus the
   -- occupancy of the address FIFO.  Note the explicit to_integer: without it
   -- the addition is performed in two bits and wraps modulo four, which makes
   -- the comparison unsound.
   f_inv_pending : assert always
      {not rst_i} |-> {wb_pending = tsf_in_addr_fill + f_stb_pending};

   -- Every address in the address FIFO either has its data waiting in the data
   -- buffer, or is still outstanding on the bus.
   --
   -- wb_stale is the part of f_wb_outstanding whose addresses are NOT in the
   -- FIFO any more: a redirect flushes the FIFO but leaves those requests owed
   -- an acknowledgement on the bus. Written with wb_stale added to the left
   -- rather than subtracted from the right so that no intermediate value can
   -- go negative. Unlike the shadow state above, this reads an RTL signal
   -- directly -- which the rest of this k-induction section already does for
   -- wb_pending and the two fill counts, since these are invariants about the
   -- implementation rather than about the interface.
   f_inv_fill : assert always
      {not rst_i} |->
      {tsf_in_addr_fill + wb_stale = tsb_in_data_fill + f_wb_outstanding};

   -- While an acknowledgement is still owed to an abandoned request, nothing
   -- can yet have arrived for the new instruction stream: the slave
   -- acknowledges in order, so every live response is behind every stale one,
   -- and the data buffer was flushed by the redirect that created the stale
   -- count in the first place.
   --
   -- Induction needs this stated explicitly. It starts from an arbitrary
   -- state, in which a non-zero wb_stale and a non-empty data buffer can
   -- coexist -- and from there the next acknowledgement is discarded while a
   -- response already in the buffer gets paired with an address from the new
   -- stream, which is exactly the corruption f_dc_data_integrity forbids.
   -- Without this invariant that property is true but not inductive.
   f_inv_stale_data_empty : assert always
      {rst_i = '0' and wb_stale > 0} |-> {tsb_in_data_fill = 0};

   -- Slot allocation bounds the outstanding request count.  The bound itself is
   -- unchanged by the redirect fast path: FETCH refuses it, and tears the bus
   -- cycle down instead, whenever taking it would need a third request slot.
   f_inv_bound : assert always
      {not rst_i} |-> {wb_pending <= 2 and f_wb_outstanding <= 2 and
                       f_wb_outstanding <= wb_pending + wb_stale};

   -- STB is only ever asserted together with CYC.
   f_inv_stb_cyc : assert always {wb_stb_o} |-> {wb_cyc_o};

   -- CYC must be high whenever a request is still owed an acknowledgement.
   -- This is the same-cycle companion to f_wb_master_cyc_hold and carries no
   -- sampling skew, so it is the property that genuinely rules out an early
   -- termination of the bus cycle.  It holds because the outstanding counter
   -- is only ever cleared together with CYC (on reset or abort), and CYC is
   -- only ever released once the counter has reached zero.
   f_inv_cyc_outstanding : assert always
      {f_wb_outstanding > 0} |-> {wb_cyc_o = '1'};

   -- STRENGTHENING INVARIANTS FOR f_dc_assert_addr
   --
   -- f_dc_assert_addr is true but not inductive on its own.  Induction begins
   -- from an arbitrary state, and nothing above relates f_dc_last_addr to the
   -- addresses actually held in the address FIFO, so the solver may posit
   -- f_dc_last_addr_valid = '1' with a FIFO head bearing no relation to it.
   --
   -- The anchor is f_wb_addr, the next address to be requested.  Every address
   -- currently in flight is determined by it:
   --
   --    - the request waiting on STB, if any, has address f_wb_addr
   --      (this is f_wb_master_address);
   --    - the FIFO holds the addresses f_wb_addr - fill .. f_wb_addr - 1,
   --      oldest first;
   --    - therefore the next address due at the DECODE output is
   --      f_wb_addr - fill, and the one delivered before it was
   --      f_wb_addr - fill - 1.
   --
   -- Each invariant below is preserved by every transition: accepting a
   -- request increments both f_wb_addr and fill, leaving the differences
   -- unchanged; delivering a word decrements fill and advances
   -- f_dc_last_addr by exactly one; an abort clears the FIFO and both valid
   -- flags in the same cycle, making the guarded invariants vacuous.

   -- The FIFO's output valid must agree with its occupancy.  Stated as two
   -- implications rather than an equality, because GHDL's PSL boolean layer
   -- parses a relational expression as a complete boolean and rejects a
   -- second "=" joining two parenthesised comparisons.
   f_inv_fifo_valid_set : assert always {rst_i = '0' and tsf_in_addr_fill /= 0}
                                    |-> {tsf_out_addr_valid = '1'};

   f_inv_fifo_valid_clr : assert always {rst_i = '0' and tsf_in_addr_fill = 0}
                                    |-> {tsf_out_addr_valid = '0'};

   -- The head of the address FIFO is the oldest address in flight.
   f_inv_fifo_head : assert always {rst_i = '0' and tsf_out_addr_valid = '1'}
                               |-> {tsf_out_addr_data = f_wb_addr - tsf_in_addr_fill};

   -- pipe_concat passes the FIFO head straight through to the DECODE output.
   -- This holds structurally if pipe_concat is combinational; if it is a
   -- registered stage, this invariant is false and the two above must be
   -- re-expressed one pipeline stage further downstream.  The same caveat
   -- applies to f_inv_pending above.
   f_inv_dc_addr : assert always {rst_i = '0' and dc_valid_o = '1'}
                             |-> {dc_addr_o = tsf_out_addr_data};

   -- The last address delivered to DECODE sits immediately below the oldest
   -- address still in flight.  Together with f_inv_fifo_head and
   -- f_inv_dc_addr, this is exactly what f_dc_assert_addr claims, so this is
   -- the load-bearing invariant of the group.
   f_inv_last_addr : assert always {rst_i = '0' and f_dc_last_addr_valid = '1'}
                               |-> {f_dc_last_addr = f_wb_addr - tsf_in_addr_fill - 1};

   -- Before the first delivery after a redirect, the oldest address in flight
   -- is the new PC itself.  This is the corresponding strengthening for
   -- f_dc_new_pc_addr, which is non-inductive for the same reason.
   f_inv_new_pc : assert always {rst_i = '0' and f_dc_new_pc_valid = '1'}
                            |-> {f_dc_new_pc = f_wb_addr - tsf_in_addr_fill};


   ----------------------------------------------
   -- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
   ----------------------------------------------

   -- Assume no reset after the first clock cycle
--   f_reset2 : assume always {not rst_i} |=> {not rst_i};

   -- Assume DECODE is always ready
--   f_dc_ready_always : assume always {dc_ready_i};

   -- Assume DECODE never resets the address
--   f_dc_after_reset2 : assume always {not rst_i} |=> {not dc_valid_i};

   -- Assume the WISHBONE slave never stalls.
--   f_wb_no_stall : assume always {not wb_stall_i};

   -- Assume the WISHBONE slave responds on the exact following cycle.
--   f_wb_response : assume always {wb_stb_o and not wb_stall_i and not rst_i} |=> {wb_ack_i};

   -- DECODE ASSUME: Always remain ready, when not receiving new data.
--   f_dc_ready_hold : assume always {dc_ready_i and not dc_valid_o} |=> {dc_ready_i};

   -- BOUNDED PROGRESS: with the artificial stall/ack constraints above, an
   -- always-ready DECODE must receive an instruction within a bounded
   -- number of cycles.  The bound is empirical -- enable this together with
   -- f_dc_ready_always and f_reset2, and raise the limit if it trips.
--   signal f_no_output_delay : integer range 0 to 31 := 0;
--   p_no_output_delay : process (clk_i)
--   begin
--      if rising_edge(clk_i) then
--         if dc_valid_o = '0' and rst_i = '0' and dc_valid_i = '0' then
--            f_no_output_delay <= f_no_output_delay + 1;
--         else
--            f_no_output_delay <= 0;
--         end if;
--      end if;
--   end process p_no_output_delay;
--   f_dc_progress : assert always {f_no_output_delay <= 15};

} -- vunit i_fetch(fetch(synthesis))

