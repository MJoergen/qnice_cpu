vunit i_sequencer(sequencer(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   --------------------------------------------
   -- INTERNAL ASSERTIONS
   --------------------------------------------


   ---------------------------------------
   -- PROPERTIES OF THE OUTPUT INTERFACE
   ---------------------------------------

   -- Output payload/valid are held stable while stalled downstream.
   --
   -- The three register-file fields are excluded, and enumerating the rest is
   -- the price of that. This module joins reg_src_val_i / reg_dst_val_i /
   -- reg_r14_i onto the record live, and they are *required* to move while a
   -- sequence is being issued: that is how the second micro-op of e.g.
   -- ADD @R0++, @R0++ sees the R0 update the first one made, and how a stalled
   -- instruction picks up a Status Register write from the instruction still in
   -- WRITE. f_live_* below pins those three down instead.
   f_stable : assert always
      {m_valid_o and not m_ready_i and not rst_i} |=>
      {stable(m_valid_o) and
       stable(m_stage_o.microcodes) and
       stable(m_stage_o.addr) and
       stable(m_stage_o.inst) and
       stable(m_stage_o.immediate) and
       stable(m_stage_o.src_addr) and
       stable(m_stage_o.src_mode) and
       stable(m_stage_o.src_imm) and
       stable(m_stage_o.dst_addr) and
       stable(m_stage_o.dst_mode) and
       stable(m_stage_o.dst_imm) and
       stable(m_stage_o.res_reg) and
       stable(m_stage_o.is_crb) and
       stable(m_stage_o.early_jmp) and
       stable(m_stage_o.alu_oper) and
       stable(m_stage_o.alu_ctrl) and
       stable(m_stage_o.alu_flags) and
       stable(m_stage_o.alu_src_val) and
       stable(m_stage_o.alu_dst_val)};

   -- The register file's read data is joined on live, with nothing latching it
   -- here. This is what makes excluding the three fields above safe rather than
   -- a hole: they are not unconstrained, they are pinned to their sources in
   -- every cycle.
   f_live_src : assert always {m_stage_o.src_val = reg_src_val_i};
   f_live_dst : assert always {m_stage_o.dst_val = reg_dst_val_i};
   f_live_r14 : assert always {m_stage_o.r14     = reg_r14_i};

   -- Output valid is a pure pass-through of input valid
   f_valid_follows : assert always {m_valid_o = s_valid_i};

   -- No new input is accepted before the last chunk has been presented
   f_hold_until_last : assert always
      {m_valid_o = '1' and m_stage_o.microcodes(C_LAST) = '0'} |-> {s_ready_o = '0'};


   ----------------------------------------------
   -- SEQUENCE INDEX INVARIANTS (aid k-induction)
   ----------------------------------------------

   -- Advance by one on an accepted non-last beat
   f_index_advance : assert always
      {m_valid_o = '1' and m_ready_i = '1' and m_stage_o.microcodes(C_LAST) = '0' and rst_i = '0'} |=>
      {index = prev(index) + 1};

   -- Restart at 0 after an accepted last beat
   f_index_restart : assert always
      {m_valid_o = '1' and m_ready_i = '1' and m_stage_o.microcodes(C_LAST) = '1' and rst_i = '0'} |=>
      {index = 0};

   -- Hold index when no beat is accepted
   f_index_stable : assert always
      {not (m_valid_o and m_ready_i) and not rst_i} |=> {stable(index)};

   -- 'index' never leaves its declared subtype. Trivially true in VHDL, but
   -- needed by k-induction: 'index' synthesises to ceil(log2(C_NUM_CHUNKS))
   -- bits, so induction would otherwise be free to start from an encoding
   -- above C_NUM_CHUNKS-1 that the subtype makes unreachable.
   f_index_range : assert always {index <= C_NUM_CHUNKS - 1};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Upstream (DECODE) holds valid + payload until accepted
   assume always
      {s_valid_i and not s_ready_o} |=> {stable(s_valid_i) and stable(s_stage_i)};

   -- Contract: 'last' must be set in the top chunk of the list, else 'index'
   -- overflows its 0..C_NUM_CHUNKS-1 subtype and the chunk slice runs past the
   -- end of 'microcodes' (see CONTRACT note in sequencer.vhd).
   assume always
      {index = C_NUM_CHUNKS - 1 and m_valid_o = '1'} |-> {m_stage_o.microcodes(C_LAST) = '1'};


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- A non-last (multi-chunk) beat is reachable
   c_multi_chunk : cover
      {m_valid_o = '1' and m_ready_i = '1' and m_stage_o.microcodes(C_LAST) = '0'};

   -- A sequence completes (last beat accepted)
   c_last_chunk : cover
      {m_valid_o = '1' and m_ready_i = '1' and m_stage_o.microcodes(C_LAST) = '1'};


   ----------------------------------------------
   -- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
   ----------------------------------------------


} -- vunit i_sequencer(sequencer(synthesis))

