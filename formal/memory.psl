vunit i_memory(memory(synthesis))
{

   -- set all declarations to run on clk
   default clock is rising_edge(clk_i);


   --------------------------------------------
   -- INTERNAL ASSERTIONS
   --------------------------------------------

   -- Load-bearing property: a response must never be pushed into a full buffer.
   -- Whenever a buffer input is valid it must also be ready. This holds because
   -- at most two SRC (resp. DST) requests are outstanding (mreq_accept gating +
   -- depth-2 FIFO), so a depth-2 two_stage_buffer is never pushed while full.
   f_tsb_src_in_overflow : assert always {tsb_src_in_valid and not rst_i} |-> {tsb_src_in_ready};
   f_tsb_dst_in_overflow : assert always {tsb_dst_in_valid and not rst_i} |-> {tsb_dst_in_ready};
   f_tsf_req_in_overflow : assert always {tsf_req_in_valid and not rst_i} |-> {tsf_req_in_ready};


   ------------------------------------------------
   -- PROPERTIES OF THE WISHBONE MASTER INTERFACE
   ------------------------------------------------

   signal f_wb_req_count   : integer range 0 to 3 := 0;

   -- Count the number of outstanding WISHBONE requests
   p_wb_req_count : process (clk_i)
   begin
      if rising_edge(clk_i) then
         -- Request without response
         if (wb_cyc_o and wb_stb_o and not wb_stall_i) and not (wb_cyc_o and wb_ack_i) then
            f_wb_req_count <= f_wb_req_count + 1;
         end if;

         -- Reponse without request
         if not(wb_cyc_o and wb_stb_o and not wb_stall_i) and (wb_cyc_o and wb_ack_i) then
            f_wb_req_count <= f_wb_req_count - 1;
         end if;

         -- If CYC goes low mid-transaction, the transaction is aborted.
         if rst_i or not wb_cyc_o then
            f_wb_req_count <= 0;
         end if;
      end if;
   end process p_wb_req_count;


   -- WISHBONE MASTER: Clear all requests while in reset
   f_wb_master_reset : assert always {rst_i} |-> {not wb_cyc_o and not wb_stb_o};

   -- WISHBONE MASTER: STB must be low when CYC is low.
   f_wb_master_stb_low : assert always {not wb_cyc_o} |-> {not wb_stb_o};

   -- WISHBONE MASTER: While a request is stalled it cannot change, except on reset or abort.
   f_wb_master_stable : assert always {wb_stb_o and wb_stall_i and not rst_i} |=>
     {rst_i = '1' or (stable(wb_stb_o) and stable(wb_addr_o) and stable(wb_we_o) and stable(wb_dat_o))};

   -- WISHBONE MASTER: Number of outstanding requests is always limited to at most two.
   --
   -- NOTE ON INDUCTION STATUS: this property is currently proven only up to
   -- the bounded BMC depth (see memory.sby), not by k-induction. An attempt
   -- to close it -- tying f_wb_req_count to the type-tracking FIFO's
   -- type-guaranteed tsf_req_fill<=2 bound, the same technique that closed
   -- f_tsb_src_in_overflow / f_tsb_dst_in_overflow / f_tsf_req_in_overflow
   -- below -- got substantially further than before but did not close: the
   -- simple "one item may be staged-but-not-yet-slave-accepted" gap term
   -- breaks down because i_one_stage_buffer_wb (depth 1) can accept a brand
   -- new request the SAME cycle it hands an old one to the slave, so more
   -- than one fifo push can be "not yet reflected in f_wb_req_count" at once
   -- -- a single wb_stb_o bit can't represent that count. Closing this
   -- properly needs a per-item view of that gap (plausibly reusing the
   -- p_shadow_fifo_content technique below), not just another arithmetic
   -- adjustment.
   f_wb_master_request : assert always {rst_i = '1' or f_wb_req_count <= 2};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   signal f_wb_stall_delay : integer range 0 to 4 := 0;
   signal f_wb_ack_delay   : integer range 0 to 4 := 0;

   -- Count the number of clock cycles the WISHBONE SLAVE stalls
   p_wb_stall_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         -- Stalled request
         if wb_cyc_o and wb_stb_o and wb_stall_i then
            f_wb_stall_delay <= f_wb_stall_delay + 1;
         else
            f_wb_stall_delay <= 0;
         end if;
      end if;
   end process p_wb_stall_delay;

   -- Count the number of clock cycles the WISHBONE SLAVE waits before responding
   p_wb_ack_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         -- Transaction without response
         if (f_wb_req_count > 0 or (wb_cyc_o = '1' and wb_stb_o = '1' and wb_stall_i = '0')) and wb_cyc_o = '1' and wb_ack_i = '0' then
            f_wb_ack_delay <= f_wb_ack_delay + 1;
         else
            f_wb_ack_delay <= 0;
         end if;
      end if;
   end process p_wb_ack_delay;


   -- Require reset at startup.
   f_reset : assume {rst_i};

   -- WISHBONE SLAVE: No ACKs without a request
   f_wb_slave_ack_idle : assume always {f_wb_req_count = 0} |-> {not wb_ack_i};

   -- WISHBONE SLAVE: Only stall for at most 3 clock cycles. This is an artifical constraint.
   f_wb_slave_stall_delay_max : assume always {f_wb_stall_delay <= 3};

   -- WISHBONE SLAVE: Respond within at most 3 clock cycles. This is an artifical constraint.
   f_wb_slave_ack_delay_max : assume always {f_wb_ack_delay <= 3};

   -- EXECUTE: Restrict valid inputs to one-hot encoding
   f_exe_op : assume always {mreq_valid_i} |-> {mreq_op_i = "001" or mreq_op_i = "010" or mreq_op_i = "100"};

   -- EXECUTE producer contract: while a request is offered but not yet
   -- accepted (mreq_ready_o low), valid must stay asserted and the payload
   -- must remain stable. This mirrors how the real EXECUTE stage behaves and
   -- is what the combinational Wishbone request path relies on.
   f_mreq_stable : assume always {mreq_valid_i and not mreq_ready_o and not rst_i} |=>
         {rst_i = '1' or (stable(mreq_valid_i) and stable(mreq_op_i) and stable(mreq_addr_i) and stable(mreq_data_i))};


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   f_cover_burst2 : cover {msrc_valid_o and msrc_ready_i and not mdst_ready_i;
                           mdst_valid_o and mdst_ready_i and not msrc_ready_i;
                           msrc_valid_o and msrc_ready_i and not mdst_ready_i;
                           mdst_valid_o and mdst_ready_i and not msrc_ready_i};

   -- OUTPUT src data
   f_cover_out_src : cover {msrc_valid_o};

   -- OUTPUT dst data
   f_cover_out_dst : cover {mdst_valid_o};

   f_cover_burst : cover {rst_i = '0';
                          mreq_valid_i = '1' and mreq_ready_o = '1' and mreq_op_i = "100";
                          mreq_valid_i = '1' and mreq_ready_o = '1' and mreq_op_i = "010";
                          mreq_valid_i = '1' and mreq_ready_o = '1' and mreq_op_i = "001"};


   ----------------------------------------------
   -- ADDITIONAL ASSERTS NEEDED FOR K-INDUCTION
   ----------------------------------------------

   -- i_two_stage_fifo_mem holds up to 2 entries, in two internal slots: a
   -- "tail" (input slot, occupied iff tsf_req_in_ready='0') and a "head"
   -- (output slot, occupied iff tsf_req_out_valid='1', and directly visible
   -- via tsf_req_out_data). Neither slot's storage register is a port, so
   -- this proof cannot read them directly (GHDL's synth-for-formal flow does
   -- not support VHDL-2008 external names for that -- confirmed by testing).
   --
   -- Instead, these two signals faithfully MIRROR the FIFO's own internal
   -- transition rules (two_stage_fifo.vhd's p_s_data / p_m), using this
   -- entity's own ports (tsf_req_in_ready/tsf_req_out_valid/tsf_req_out_ready)
   -- as stand-ins for the FIFO's internal s_ready_r/m_valid_r/m_ready_i --
   -- valid stand-ins because s_ready_o<=s_ready_r and m_valid_o<=m_valid_r
   -- are direct, ungated wires in that module, and m_ready_i is simply this
   -- entity's own port passed through.
   --
   -- Despite mirroring rather than reading the real registers, this is
   -- provable: both real slots are OVERWRITTEN from mreq_op_i (a known, fully
   -- observed value) unconditionally whenever they are "ready to accept" --
   -- s_data_r every cycle s_ready_r='1', m_data_r whenever s_ready_r='1' and
   -- (m_valid_r='0' or draining) -- which happens often enough that any
   -- mismatch from an adversarial k-induction seed self-corrects within a few
   -- cycles, rather than persisting forever the way a simple push/pop event
   -- counter's seed value would (that was the earlier, failed approach).
   signal f_shadow_tail_is_dst : std_logic := '0';
   signal f_shadow_tail_is_src : std_logic := '0';
   signal f_shadow_head_is_dst : std_logic := '0';
   signal f_shadow_head_is_src : std_logic := '0';

   p_shadow_fifo_content : process (clk_i)
   begin
      if rising_edge(clk_i) then
         -- Mirrors p_s_data: overwritten every cycle the tail slot is free to
         -- accept, regardless of previous content.
         if tsf_req_in_ready = '1' then
            f_shadow_tail_is_dst <= mreq_op_i(C_MEM_READ_DST);
            f_shadow_tail_is_src <= mreq_op_i(C_MEM_READ_SRC);
         end if;

         -- Mirrors p_m.
         if tsf_req_in_ready = '1' then
            if tsf_req_out_valid = '0' or tsf_req_out_ready = '1' then
               f_shadow_head_is_dst <= mreq_op_i(C_MEM_READ_DST);
               f_shadow_head_is_src <= mreq_op_i(C_MEM_READ_SRC);
            end if;
         else
            if tsf_req_out_ready = '1' then
               f_shadow_head_is_dst <= f_shadow_tail_is_dst;
               f_shadow_head_is_src <= f_shadow_tail_is_src;
            end if;
         end if;
      end if;
   end process p_shadow_fifo_content;

   -- The checkpoint: the shadow head must agree with the real, externally
   -- visible head (tsf_req_out_data) whenever it's valid. This is provable by
   -- induction (see comment above) and is what lets f_shadow_tail_is_dst /
   -- f_shadow_tail_is_src be trusted below, since the same self-correcting
   -- argument applies to the tail one step earlier (whatever the tail holds
   -- becomes the checked head on the very next shift).
   f_shadow_head_matches_dst : assert always {rst_i = '1' or tsf_req_out_valid = '0' or tsf_req_out_data(C_MEM_READ_DST) = f_shadow_head_is_dst};
   f_shadow_head_matches_src : assert always {rst_i = '1' or tsf_req_out_valid = '0' or tsf_req_out_data(C_MEM_READ_SRC) = f_shadow_head_is_src};

   -- Derived occupancy counts, content-based rather than event-counted: the
   -- head's type comes straight from the real tsf_req_out_data (no shadow
   -- needed there), the tail's from the checked shadow above.
   signal f_dst_fifo_count : integer range 0 to 2;
   signal f_src_fifo_count : integer range 0 to 2;

   p_fifo_type_counts : process (all)
      variable v_dst : integer range 0 to 2;
      variable v_src : integer range 0 to 2;
   begin
      v_dst := 0;
      v_src := 0;

      if tsf_req_out_valid = '1' and tsf_req_out_data(C_MEM_READ_DST) = '1' then
         v_dst := v_dst + 1;
      end if;
      if tsf_req_in_ready = '0' and f_shadow_tail_is_dst = '1' then
         v_dst := v_dst + 1;
      end if;

      if tsf_req_out_valid = '1' and tsf_req_out_data(C_MEM_READ_SRC) = '1' then
         v_src := v_src + 1;
      end if;
      if tsf_req_in_ready = '0' and f_shadow_tail_is_src = '1' then
         v_src := v_src + 1;
      end if;

      f_dst_fifo_count <= v_dst;
      f_src_fifo_count <= v_src;
   end process p_fifo_type_counts;

   -- The goal: total outstanding SRC (resp. DST) work -- entries still unacked
   -- in the FIFO, plus responses already delivered but not yet consumed by
   -- EXECUTE -- never exceeds 2. This is what f_tsb_src_in_overflow /
   -- f_tsb_dst_in_overflow actually rely on.
   f_dst_total_max : assert always {rst_i = '1' or f_dst_fifo_count + tsb_dst_fill <= 2};
   f_src_total_max : assert always {rst_i = '1' or f_src_fifo_count + tsb_src_fill <= 2};

   -- f_dst_total_max / f_src_total_max additionally rely on two cross-module
   -- invariants of the src/sub/ instances they're built from -- see the
   -- separate i_two_stage_buffer_internal / i_two_stage_fifo_internal vunits
   -- below (bound directly to those sub-entities, so they apply to every
   -- instance of them within this hierarchy).

   ----------------------------------------------
   -- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
   ----------------------------------------------

} -- vunit i_memory(memory(synthesis))


-- ---------------------------------------------------------------------------
-- Cross-module induction support.
--
-- These two vunits bind directly to src/sub/ entities rather than to
-- `memory`, so GHDL/yosys attach them to EVERY elaborated instance of that
-- entity/architecture within the `memory` hierarchy -- both
-- i_two_stage_buffer_src and i_two_stage_buffer_dst pick up
-- i_two_stage_buffer_internal below, for instance. This proof compiles the
-- real src/sub/ RTL but not each module's own formal/*.psl, so without these,
-- k-induction is free to seed those sub-instances in states that violate
-- invariants they rely on internally (already proven standalone in their own
-- .psl files) -- which lets their s_fill_o outputs under-report true
-- occupancy and breaks f_dst_total_max / f_src_total_max in i_memory above.
-- ---------------------------------------------------------------------------

vunit i_two_stage_buffer_internal(two_stage_buffer(synthesis))
{
   default clock is rising_edge(clk_i);

   -- Mirrors f_internal from two_stage_buffer.psl: this transparent 2-stage
   -- pipe always fills "from the back", so stage 1 can never be occupied
   -- while stage 2 is empty.
   f_internal : assert always {not int_afull} |-> {not s_afull};
}

vunit i_two_stage_fifo_internal(two_stage_fifo(synthesis))
{
   default clock is rising_edge(clk_i);

   -- Mirrors f_inv_empty_ready from two_stage_fifo.psl: an empty FIFO must
   -- always be ready.
   f_inv_empty_ready : assert always {rst_i = '0' and m_valid_o = '0'} |-> {s_ready_o = '1'};
}

