# bmc is the check: "make -C formal" and CI run it, and only the tasks tagged
# default run when sby is given no task name. bmc_quick is for development:
# the same assertions to a shallower depth, run by name,
#
#    sby --yosys "yosys -m ghdl" -f cpu_main.sby bmc_quick
#
# Almost all of bmc's time is in its last steps -- at depth 20, step 19 alone
# takes about 7 of its 16 minutes -- so bmc_quick, at depth 16, takes under 3
# (2m40s measured). It proves less, and the deepest cover is reached at step 9,
# so a pass here is not a pass: run bmc before committing.
[tasks]
cover : default
bmc : default
bmc_quick

[options]
cover: mode cover
cover: depth 20
bmc: mode bmc
bmc: depth 20
bmc_quick: mode bmc
bmc_quick: depth 16

[engines]
smtbmc

[script]
ghdl --std=08 \
   cpu_main.psl \
   cpu_constants.vhd \
   alu_data.vhd \
   alu_flags.vhd \
   alu.vhd \
   microcode.vhd \
   decode.vhd \
   sequencer.vhd \
   prepare.vhd \
   write.vhd \
   cpu_main.vhd \
   cpu_main.psl -e cpu_main
prep -top cpu_main

[files]
cpu_main.psl
../src/cpu_constants.vhd
../src/cpu_main/sub/alu_data.vhd
../src/cpu_main/sub/alu_flags.vhd
../src/cpu_main/sub/alu.vhd
../src/cpu_main/sub/microcode.vhd
../src/cpu_main/decode.vhd
../src/cpu_main/sequencer.vhd
../src/cpu_main/prepare.vhd
../src/cpu_main/write.vhd
../src/cpu_main/cpu_main.vhd

