# GHDL / simulation
work-obj08.cf
test/*.ghw
test/*.rom
test/*.lis
test/*.out
# Log of every register and memory write; the committed reference copies are
# test/*.writes.golden, see test/README.md
test/*.writes
# Per-run statistics; the committed reference copies are test/*.stats.golden
test/*.stats
# "make crosscheck" work directory: the reference emulator's sources extracted
# at the pinned upstream commit, the binary built from them, and the memory
# dumps it produces. All generated -- the harness itself is test/crosscheck.py,
# which IS committed.
test/crosscheck/

# LaTeX intermediates from "make diagrams" (the .tex files listed in the
# Makefile's TIMINGS and BLOCK_DIAGRAMS). The rule removes these itself; these
# entries catch a hand-run pdflatex, which drops them in whatever directory it
# was invoked from.
*.aux
*.pdf
*.synctex.gz
texput.log
*timing.log
doc/cpu.log

# Yosys
yosys.log
system.edif
cpu.edif

# Vivado
hw/system.tcl
post_synth.dcp
post_route.dcp
timing_summary.rpt
utilization_placed.rpt
utilization_hier.rpt
hw/system_hier.tcl
system.bit
vivado*
usage_statistics_webtalk*
tight_setup_hold_pins.txt
.Xil/

# Editor scratch files. Vim names its swap file for src/foo.vhd
# src/.foo.vhd.swp, and falls back to .swo, .swn, ... when one is already
# there, so match the whole range rather than just .swp.
.*.sw[a-p]
*~
